---
import event from "@data/featured-event.json";

/**
 * Slim strip above the masthead for the event we last hosted. The full
 * details live in the modal it opens, which keeps a dated promotion out of
 * the homepage layout itself.
 */
const { name, dateLabel } = event;
const shortDate = new Date(event.date).toLocaleDateString("en-US", {
  month: "short",
  day: "numeric",
  timeZone: "UTC",
});
---

<aside class="strip" data-event-bar aria-label={`Past event: ${name}`}>
  <div class="wrap inner font-mono upper">
    <p class="lede">
      <span class="mark" aria-hidden="true"></span>
      <strong>{name}</strong>
      <span class="sep" aria-hidden="true">/</span>
      <span>Wrapped {shortDate}</span>
      <span class="thanks">— thanks for building with us</span>
    </p>
    <button type="button" class="recap" data-event-open>
      Recap <span aria-hidden="true">→</span>
    </button>
  </div>
  <p class="sr-only">{name} ended on {dateLabel}.</p>
</aside>

<style>
  .strip {
    background: var(--ink);
    color: var(--paper);
  }

  .inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-height: 34px;
    /* Block padding only: .wrap owns the side gutters. */
    padding-block: 8px;
    font-size: 11px;
    letter-spacing: 0.12em;
  }

  .lede {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0;
    min-width: 0;
    white-space: nowrap;
    overflow: hidden;
  }

  .lede strong { font-weight: 700; }

  .mark {
    width: 6px;
    height: 6px;
    flex: none;
    background: var(--accent);
  }

  .sep,
  .thanks { color: var(--inverse-muted); }
  .thanks { overflow: hidden; text-overflow: ellipsis; }

  .recap {
    flex: none;
    font: inherit;
    letter-spacing: inherit;
    text-transform: inherit;
    color: inherit;
    background: none;
    border: 0;
    padding: 2px 0;
    cursor: pointer;
    border-bottom: 1px solid var(--inverse-rule);
    transition: color var(--dur-fast) ease, border-color var(--dur-fast) ease;
  }
  .recap:hover { color: var(--accent); border-color: var(--accent); }
  .recap:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }

  @media (max-width: 720px) {
    .thanks { display: none; }
  }
</style>
