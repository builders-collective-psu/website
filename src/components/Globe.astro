---
/**
 * Desktop-only globe in the hero's top-right corner. The drawing code lives in
 * src/lib/globe.ts and is imported only when the viewport is wide enough.
 */
---

<div class="globe" data-globe aria-hidden="true">
  <svg viewBox="0 0 320 320" width="320" height="320"></svg>
  <div class="notes" data-notes></div>
</div>

<script>
  const root = document.querySelector<HTMLElement>("[data-globe]");
  if (root && window.matchMedia("(min-width: 1180px)").matches) {
    import("../lib/globe").then(({ initGlobe }) => initGlobe(root));
  }
</script>

<style>
  .globe {
    position: absolute;
    top: -12px;
    right: var(--gutter-desktop);
    width: 300px;
    height: 300px;
    pointer-events: none;
    opacity: 0;
    transition: opacity 400ms ease;
  }
  .globe[data-ready] { opacity: 1; }
  .globe svg { position: relative; width: 100%; height: 100%; overflow: visible; }

  /* Music notes fly up from the beacon, one per note played. */
  .notes { position: absolute; inset: 0; }
  /* Pinned to a place on the globe; moved by script as the globe turns. */
  .notes :global(.note-anchor) { position: absolute; left: 0; top: 0; width: 0; height: 0; }
  .notes :global(.note) {
    position: absolute;
    left: 0;
    top: 0;
    font-size: var(--size, 22px);
    line-height: 1;
    color: var(--tint, var(--accent));
    font-weight: 700;
    animation: note-fly 2200ms cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }
  .notes :global(.note > span) { display: inline-block; animation: note-wobble 700ms ease-in-out infinite alternate; }
  /* Offsets are relative to the note's anchor (its place on the globe). */
  @keyframes note-fly {
    0% { transform: translate(-50%, -50%) scale(0.4); opacity: 0; }
    10% { opacity: 1; }
    25% { transform: translate(calc(-50% + var(--dx) / 2), calc(-50% + var(--dy) / 2)) scale(1.3) rotate(var(--rot)); }
    40% { transform: translate(calc(-50% + var(--dx) * 2 / 3), calc(-50% + var(--dy) * 2 / 3)) scale(1) rotate(var(--rot)); }
    75% { opacity: 1; }
    100% { transform: translate(calc(-50% + var(--dx)), calc(-50% + var(--dy) - 10px)) scale(0.9) rotate(calc(var(--rot) * -1)); opacity: 0; }
  }
  @keyframes note-wobble {
    from { transform: translateX(-2px); }
    to { transform: translateX(2px); }
  }

  .globe :global(.g-sphere) { fill: var(--paper-2); stroke: var(--ink); stroke-width: 1.5; }
  .globe :global(.g-grid) { fill: none; stroke: var(--hairline); stroke-width: 0.75; }
  .globe :global(.g-land) { fill: color-mix(in srgb, var(--ink) 14%, transparent); stroke: none; }
  .globe :global(.g-dot) { fill: var(--muted); opacity: 0.55; }
  .globe :global(.g-dot--won) {
    fill: var(--accent);
    opacity: 1;
    /* Tappable, with a hit area wider than the dot. */
    pointer-events: all;
    cursor: pointer;
    stroke: transparent;
    stroke-width: 14;
    transition: r 160ms ease;
  }
  .globe :global(.g-dot--won:hover) { r: 5; }

  .globe :global(.g-beacon) {
    fill: none;
    stroke: var(--accent);
    stroke-width: 2;
    transform-box: fill-box;
    transform-origin: center;
  }
  .globe :global(.g-beacon.is-ping) { animation: ping 1280ms ease-out infinite; }
  @keyframes ping {
    0% { transform: scale(1); opacity: 1; }
    100% { transform: scale(4.5); opacity: 0; }
  }

  @media (max-width: 1179px) {
    .globe { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .notes { display: none; }
    .globe :global(.g-beacon.is-ping) { animation: none; }
  }
</style>
