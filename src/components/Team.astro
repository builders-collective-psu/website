---
import { existsSync } from "node:fs";
import SectionHeader from "./ui/SectionHeader.astro";
import alumni from "@data/alumni.json";

interface Member {
  id: string;
  name: string;
  role: string;
  /** Academic detail shown as badges. Left blank until we have it. */
  major?: string;
  year?: string;
  linkedin?: string;
  /** LinkedIn username; also the filename of their photo, if we have one. */
  linkedinSlug?: string;
  /** Initials tile, used when there is no photo. */
  portrait?: string;
}

interface Props {
  team: Member[];
}

const { team } = Astro.props;

/**
 * Photos live in public/headshots/linkedin/<linkedinSlug>.<ext> — see the
 * README there. Resolved at build time so a missing photo quietly falls back
 * to the initials tile instead of rendering a broken image.
 */
const PHOTO_EXTENSIONS = ["jpg", "jpeg", "png", "webp"];

function photoFor(slug?: string): string | undefined {
  if (!slug) return undefined;
  for (const ext of PHOTO_EXTENSIONS) {
    const path = `headshots/linkedin/${slug}.${ext}`;
    if (existsSync(new URL(`../../public/${path}`, import.meta.url))) {
      return `/${path}`;
    }
  }
  return undefined;
}

const cards = team.map((m) => ({
  ...m,
  image: photoFor(m.linkedinSlug) ?? m.portrait,
}));
---

<section class="sec" id="team" aria-labelledby="team-heading">
  <div class="wrap">
    <SectionHeader title="Our Team" id="team-heading" />

    <div class="grid">
      {
        cards.map((m) => (
          <article class="card" aria-labelledby={`t-${m.id}`}>
            <div class="card-top font-mono upper">{m.role}</div>

            {m.image ? (
              <div class="card-portrait card-portrait--photo">
                <img
                  src={m.image}
                  alt={m.name}
                  width="200"
                  height="210"
                  loading="lazy"
                  data-headshot={m.linkedinSlug}
                />
              </div>
            ) : (
              <div
                class="card-portrait"
                role="img"
                aria-label={`Portrait placeholder for ${m.name}`}
                data-headshot-slot={m.linkedinSlug}
              >
                <span class="font-mono upper">PORTRAIT — 1:1.05</span>
              </div>
            )}

            <div class="card-info">
              <h3 id={`t-${m.id}`} class="nm">{m.name}</h3>
              {m.linkedin && (
                <a
                  class="li font-mono upper"
                  href={m.linkedin}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  LinkedIn ↗
                </a>
              )}
            </div>

            {(m.major || m.year) && (
              <div class="tags">
                {m.major && <span class="tg font-mono upper">{m.major}</span>}
                {m.year && <span class="tg font-mono upper">{m.year}</span>}
              </div>
            )}
          </article>
        ))
      }
      {/* Fills the rest of the last row, or a full row when that row is full:
          spans are worked out for the 4- and 2-column layouts. */}
      <aside
        class="alumni"
        aria-labelledby="alumni-heading"
        style={`--span4: ${4 - (cards.length % 4)}; --span2: ${2 - (cards.length % 2)};`}
      >
        <p id="alumni-heading" class="alumni-head font-mono upper">{alumni.heading}</p>
        <ul class="logos">
          {alumni.companies.map((c) => (
            <li>
              <a href={c.linkedin || c.website} target="_blank" rel="noopener noreferrer" title={c.name} class:list={["co", c.mark && "co--mark", !c.logo && "co--word"]}>
                {c.logo && <img src={c.logo} alt={c.mark ? "" : c.name} loading="lazy" />}
                {(c.mark || !c.logo) && <span class="co-name">{c.name}</span>}
              </a>
            </li>
          ))}
        </ul>
      </aside>
    </div>
  </div>
</section>

<script is:inline define:vars={{ endpoint: "/api/team-photos" }}>
  (function () {
    const slots = document.querySelectorAll("[data-headshot], [data-headshot-slot]");
    if (!slots.length) return;

    fetch(endpoint, { headers: { accept: "application/json" } })
      .then((response) => {
        if (!response.ok) throw new Error(`team-photos HTTP ${response.status}`);
        return response.json();
      })
      .then(({ photos }) => {
        if (!photos) return;

        slots.forEach((slot) => {
          const slug = slot.getAttribute("data-headshot") || slot.getAttribute("data-headshot-slot");
          const url = slug && photos[slug];
          if (!url) return;

          if (slot.tagName === "IMG") {
            slot.src = url;
            return;
          }

          // Initials tile — replace it with the real photo.
          const img = document.createElement("img");
          img.src = url;
          img.alt = slot.getAttribute("aria-label")?.replace("Portrait placeholder for ", "") || "";
          img.width = 200;
          img.height = 210;
          img.loading = "lazy";
          slot.replaceChildren(img);
          slot.classList.add("card-portrait--photo");
          slot.removeAttribute("role");
          slot.removeAttribute("aria-label");
        });
      })
      .catch(() => {
        /* endpoint missing or upstream down — the built-in portraits stand */
      });
  })();
</script>

<style>
  .sec {
    padding: 72px 0;
    border-bottom: 1.5px solid var(--ink);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0;
    border-top: 1.5px solid var(--ink);
    border-left: 1.5px solid var(--ink);
  }

  .card {
    border-right: 1.5px solid var(--ink);
    border-bottom: 1.5px solid var(--ink);
    background: var(--paper);
    transition: background var(--dur-normal) ease;
    display: flex;
    flex-direction: column;
  }
  .card:hover { background: var(--paper-2); }

  /* Alumni placement: a logo cloud in the empty end of the team grid. */
  .alumni {
    grid-column: span var(--span4, 4);
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 22px;
    padding: 28px 28px 32px;
    border-right: 1.5px solid var(--ink);
    border-bottom: 1.5px solid var(--ink);
    background: var(--paper);
  }
  .alumni-head { margin: 0; font-size: 11px; letter-spacing: 0.14em; color: var(--muted); }
  .logos {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 22px 34px;
  }
  .co { display: inline-flex; align-items: center; gap: 8px; color: var(--ink); }
  /* Every logo rendered as a single-colour silhouette, inverted for dark. */
  .co img {
    display: block;
    height: 26px;
    width: auto;
    max-width: 150px;
    object-fit: contain;
    filter: brightness(0);
    opacity: 0.85;
    transition: opacity var(--dur-fast) ease;
  }
  .co--mark img { height: 22px; }
  .co-name { font-weight: 700; font-size: 17px; letter-spacing: -0.02em; line-height: 1; }
  .co--word .co-name { font-size: 19px; }
  .co:hover img, .co:focus-visible img { opacity: 1; }
  .co:hover .co-name { color: var(--accent); }
  :global([data-theme="dark"]) .co img { filter: brightness(0) invert(1); }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .co img { filter: brightness(0) invert(1); }
  }

  .card-top {
    padding: 10px 14px;
    border-bottom: 1px solid var(--ink);
    font-size: 11px;
    letter-spacing: 0.1em;
    background: var(--ink);
    color: var(--paper);
  }

  .card-portrait {
    aspect-ratio: 1 / 1.05;
    background: repeating-linear-gradient(
      135deg,
      var(--paper-2) 0 8px,
      var(--paper) 8px 16px
    );
    border-bottom: 1px solid var(--ink);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--muted);
    font-size: 11px;
    letter-spacing: 0.16em;
    position: relative;
  }
  .card-portrait::after {
    content: "";
    position: absolute;
    inset: 12px;
    border: 1px dashed var(--dash);
    pointer-events: none;
  }

  .card-portrait--photo::after { display: none; }
  .card-portrait--photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .card-info {
    padding: 14px;
    margin-top: auto;
  }
  .card-info .nm {
    font-size: 20px;
    font-weight: 700;
    letter-spacing: -0.01em;
    line-height: 1.05;
    margin: 0;
  }

  .li {
    display: inline-block;
    margin-top: 8px;
    font-size: 11px;
    letter-spacing: 0.1em;
    color: var(--muted);
    border-bottom: 1px solid currentColor;
    transition: color var(--dur-fast) ease;
  }
  .li:hover,
  .li:focus-visible {
    color: var(--accent);
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  .tags {
    padding: 0 14px 14px;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .tags .tg {
    font-size: 10px;
    letter-spacing: 0.08em;
    padding: 3px 6px;
    border: 1px solid var(--ink);
    line-height: 1.4;
  }

  @media (max-width: 1024px) {
    .grid { grid-template-columns: repeat(2, 1fr); }
    .alumni { grid-column: span var(--span2, 2); }
  }
  @media (max-width: 560px) {
    .grid { grid-template-columns: 1fr; }
    .alumni { grid-column: span 1; }
    .card-info .nm { font-size: 18px; }
  }
</style>
