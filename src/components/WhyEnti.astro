---
import SectionHeader from "./ui/SectionHeader.astro";

interface Track {
  id: string;
  kicker: string;
  name: string;
  credits: string;
  summary: string;
  courses: string[];
}

interface EntiData {
  intro: string;
  reasons: string[];
  tracks: Track[];
  email: string;
  links: { label: string; href: string }[];
}

interface Props {
  enti: EntiData;
}

const { enti } = Astro.props;
---

<section class="sec" id="enti" aria-labelledby="enti-heading">
  <div class="wrap">
    <SectionHeader
      title="Why ENTI?"
      meta="PENN STATE · COLLEGE OF ENGINEERING"
      id="enti-heading"
    />

    <div class="lede">
      <p class="intro">{enti.intro}</p>
      <ul class="reasons">
        {enti.reasons.map((reason) => <li>{reason}</li>)}
      </ul>
    </div>

    <div class="tracks">
      {
        enti.tracks.map((track) => (
          <article class="track">
            <div class="track-top font-mono upper">
              <span>{track.kicker}</span>
              <span class="credits">{track.credits}</span>
            </div>
            <h3>{track.name}</h3>
            <p>{track.summary}</p>
            <ul class="courses font-mono">
              {track.courses.map((course) => <li>{course}</li>)}
            </ul>
          </article>
        ))
      }
    </div>

    <div class="foot font-mono">
      <span>↳ QUESTIONS: <a href={`mailto:${enti.email}`}>{enti.email}</a></span>
      <span class="links">
        {
          enti.links.map((link) => (
            <a href={link.href} target="_blank" rel="noopener noreferrer">
              {link.label} ↗
            </a>
          ))
        }
      </span>
    </div>
  </div>
</section>

<style>
  .sec {
    padding: 72px 0;
    border-bottom: 1.5px solid var(--ink);
  }

  .lede {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 40px;
    align-items: start;
    margin-bottom: 36px;
  }

  .intro {
    font-size: 22px;
    line-height: 1.3;
    letter-spacing: -0.01em;
    margin: 0;
    max-width: 44ch;
  }

  .reasons {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 12px;
  }
  .reasons li {
    font-size: 15px;
    line-height: 1.45;
    padding-left: 22px;
    position: relative;
    color: var(--ink-2);
  }
  .reasons li::before {
    content: "↳";
    position: absolute;
    left: 0;
    color: var(--accent);
    font-family: var(--font-mono);
  }

  .tracks {
    display: grid;
    grid-template-columns: 1fr 1fr;
    border-top: 1.5px solid var(--ink);
    border-left: 1.5px solid var(--ink);
  }

  .track {
    border-right: 1.5px solid var(--ink);
    border-bottom: 1.5px solid var(--ink);
    padding: 0 0 24px;
    transition: background var(--dur-normal) ease;
  }
  .track:hover { background: var(--paper-2); }

  .track-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 10px 14px;
    background: var(--ink);
    color: var(--paper);
    font-size: 11px;
    letter-spacing: 0.14em;
  }
  .track-top .credits { color: var(--accent); }

  .track h3 {
    font-size: 28px;
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.05;
    margin: 20px 24px 0;
  }

  .track p {
    font-size: 15px;
    line-height: 1.45;
    margin: 10px 24px 0;
    max-width: 44ch;
  }

  .courses {
    list-style: none;
    margin: 18px 24px 0;
    padding: 0;
    display: grid;
    gap: 6px;
    font-size: 12px;
    color: var(--ink-2);
  }
  .courses li {
    padding: 6px 0;
    border-top: 1px solid var(--hairline);
    letter-spacing: 0.02em;
  }

  .foot {
    margin-top: 20px;
    font-size: 12px;
    color: var(--muted);
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px;
  }
  .foot .links {
    display: inline-flex;
    gap: 18px;
    flex-wrap: wrap;
  }
  .foot a {
    border-bottom: 1px solid currentColor;
    transition: color var(--dur-fast) ease;
  }
  .foot a:hover,
  .foot a:focus-visible {
    color: var(--accent);
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  @media (max-width: 900px) {
    .lede { grid-template-columns: 1fr; gap: 24px; }
    .intro { font-size: 19px; }
  }
  @media (max-width: 720px) {
    .tracks { grid-template-columns: 1fr; }
    .track h3 { font-size: 24px; }
  }
</style>
