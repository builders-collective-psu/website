---
/* Renders in the light state; the inline script in Base.astro has already set
   data-theme on <html>, so the label is corrected before first paint. */
---

<button
  id="theme-toggle"
  type="button"
  class="icon-btn theme-btn"
  aria-label="Switch to dark theme"
  title="Switch to dark theme"
>
  <span class="label sr-only">Dark</span>
  <svg class="glyph" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
    <circle cx="8" cy="8" r="6.3" fill="none" stroke="currentColor" stroke-width="1.4" />
    <path d="M8 1.7a6.3 6.3 0 0 1 0 12.6z" fill="currentColor" />
  </svg>
</button>

<style>
  /* The filled half flips to show which theme a click will switch to. */
  .theme-btn .glyph {
    transition: transform var(--dur-normal) var(--ease-out);
  }
  .theme-btn[data-mode="dark"] .glyph {
    transform: rotate(180deg);
  }

  @media (prefers-reduced-motion: reduce) {
    .theme-btn .glyph {
      transition: none;
    }
  }
</style>

<script>
  const KEY = "theme";
  const root = document.documentElement;
  const meta = document.querySelector('meta[name="theme-color"]');
  const media = window.matchMedia("(prefers-color-scheme: dark)");
  const button = document.getElementById("theme-toggle");
  const label = button?.querySelector(".label");

  const BAR = { light: "#F4F1EA", dark: "#0B1220" };

  function stored(): string | null {
    try {
      return localStorage.getItem(KEY);
    } catch {
      return null;
    }
  }

  function apply(theme: "light" | "dark") {
    root.dataset.theme = theme;
    meta?.setAttribute("content", BAR[theme]);
    if (button && label) {
      const next = theme === "dark" ? "light" : "dark";
      button.dataset.mode = theme;
      label.textContent = next === "dark" ? "Dark" : "Light";
      button.setAttribute("aria-label", `Switch to ${next} theme`);
      button.setAttribute("title", `Switch to ${next} theme`);
    }
  }

  const systemTheme = () => (media.matches ? "dark" : "light");

  const wantsMotion = () =>
    !window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  /**
   * Swaps the theme with a wipe across the page. View Transitions snapshot the
   * whole document, so the background and every control travel together rather
   * than each animating on its own clock.
   */
  function switchTo(theme: "light" | "dark") {
    if (!wantsMotion()) {
      apply(theme);
      return;
    }

    // Going dark sweeps left to right; coming back sweeps the other way.
    root.dataset.sweep = theme === "dark" ? "ltr" : "rtl";

    const startViewTransition = document.startViewTransition?.bind(document);
    if (!startViewTransition) {
      // No View Transitions here — cross-fade the colours instead.
      root.classList.add("theme-transition");
      apply(theme);
      window.setTimeout(() => root.classList.remove("theme-transition"), 400);
      delete root.dataset.sweep;
      return;
    }

    const transition = startViewTransition(() => apply(theme));
    transition.finished.finally(() => {
      delete root.dataset.sweep;
    });
  }

  apply((stored() as "light" | "dark" | null) ?? systemTheme());

  button?.addEventListener("click", () => {
    const next = root.dataset.theme === "dark" ? "light" : "dark";
    try {
      // Matching the device again means we stop overriding it.
      if (next === systemTheme()) localStorage.removeItem(KEY);
      else localStorage.setItem(KEY, next);
    } catch {
      /* storage unavailable — the choice just won't persist */
    }
    switchTo(next);
  });

  media.addEventListener("change", () => {
    if (!stored()) switchTo(systemTheme());
  });
</script>
