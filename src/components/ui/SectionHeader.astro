---
interface Props {
  title?: string;
  meta?: string;
  inverted?: boolean;
  id?: string;
}

const { title, meta, inverted = false, id } = Astro.props;
---

<header class:list={["sec-head", inverted && "sec-head--inv"]}>
  {title ? (
    <h2 id={id} class="sec-title display upper" set:html={title} />
  ) : (
    <h2 id={id} class="sec-title display upper"><slot /></h2>
  )}
  {meta && <div class="sec-meta font-mono upper" set:html={meta} />}
</header>

<style>
  .sec-head {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: end;
    gap: 24px;
    margin-bottom: 36px;
    padding-bottom: 18px;
    border-bottom: 1.5px solid var(--ink);
  }

  .sec-title {
    font-size: clamp(40px, 6vw, 88px);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 0.92;
    margin: 0;
  }

  .sec-meta {
    font-size: 12px;
    letter-spacing: 0.06em;
    text-align: right;
    color: var(--muted);
    line-height: 1.5;
  }

  .sec-head--inv {
    border-bottom-color: var(--inverse-rule);
  }
  .sec-head--inv .sec-meta {
    color: var(--inverse-muted);
  }
  .sec-head--inv .sec-title {
    color: var(--paper);
  }

  @media (max-width: 720px) {
    .sec-head {
      grid-template-columns: 1fr;
    }
    .sec-meta {
      text-align: left;
    }
  }
</style>
