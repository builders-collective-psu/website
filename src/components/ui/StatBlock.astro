---
interface Props {
  label: string;
  value: string | number;
  caption?: string;
  accent?: boolean;
  /**
   * Key in the /api/stats.json payload. When set, the rendered figure is a
   * placeholder that the live-stats script replaces once the platform
   * responds. Without it the value is simply static.
   */
  field?: string;
}

const { label, value, caption, accent = false, field } = Astro.props;
---

<div class="stat">
  <div class="k font-mono upper">{label}</div>
  <div class:list={["v", accent && "accent"]} data-stat={field} data-stat-format="pad">{value}</div>
  {caption && <div class="s font-mono upper">{caption}</div>}
</div>

<style>
  .stat { display: block; }
  .k {
    font-size: 11px;
    letter-spacing: 0.16em;
    color: var(--muted);
    line-height: 1.2;
  }
  .v {
    font-size: 64px;
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1;
    margin-top: 6px;
    font-variant-numeric: tabular-nums;
  }
  .v.accent { color: var(--accent); }

  /* While a live figure is in flight the number ticks upward (see
     LiveStats), which doubles as the loading state. */
  .s {
    font-size: 12px;
    margin-top: 6px;
    color: var(--muted);
    letter-spacing: 0.1em;
  }
</style>
