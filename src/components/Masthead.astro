---
import ThemeToggle from "./ui/ThemeToggle.astro";

interface SiteData {
  name: string;
  established: string;
  signInUrl: string;
  nav: { label: string; href: string }[];
  social: { linkedin?: string; github?: string };
}

interface StatsData {
  nextEvent: { name: string; daysOut: number };
}

interface Props {
  site: SiteData;
  stats: StatsData;
}

const { site } = Astro.props;
---

<header class="masthead" aria-label="Site header">
  <div class="wrap bar">
    <a class="wordmark" href="/" aria-label={`${site.name} home`}>
      <span class="logo" aria-hidden="true"></span>
      <span class="name upper">{site.name}</span>
      <span class="est font-mono upper">Est. {site.established}</span>
    </a>

    <nav class="nav font-mono upper" aria-label="Main navigation">
      {site.nav.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>

    <div class="actions">
      {site.social.linkedin && (
        <a
          class="icon"
          href={site.social.linkedin}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Builders Collective on LinkedIn"
          title="LinkedIn"
        >
          <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false" fill="currentColor">
            <path d="M3.6 5.5H.9V15h2.7V5.5ZM2.25 1a1.6 1.6 0 1 0 0 3.2 1.6 1.6 0 0 0 0-3.2ZM15 9.6c0-2.6-1.4-3.8-3.2-3.8-1.5 0-2.2.8-2.5 1.4V5.5H6.6V15h2.7V9.7c0-1.1.5-1.8 1.5-1.8s1.5.7 1.5 1.8V15H15V9.6Z" />
          </svg>
        </a>
      )}
      {site.social.github && (
        <a
          class="icon"
          href={site.social.github}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Builders Collective on GitHub"
          title="GitHub"
        >
          <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false" fill="currentColor">
            <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z" />
          </svg>
        </a>
      )}
      <span class="theme"><ThemeToggle /></span>
      <span class="divider" aria-hidden="true"></span>
      <a class="sign-in font-mono upper" href={site.signInUrl}>Sign in</a>
    </div>
  </div>
</header>

<style>
  .masthead {
    position: sticky;
    top: 0;
    z-index: 20;
    background: var(--paper);
    border-bottom: var(--rule-major) solid var(--ink);
  }

  /* Three columns so the nav sits centred regardless of how wide the
     wordmark or the action group is. */
  .bar {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 24px;
    min-height: 60px;
  }

  /* ---- Wordmark ---- */
  .wordmark {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-width: 0;
  }
  .logo {
    width: 14px;
    height: 14px;
    flex: none;
    background: var(--accent);
  }
  .name {
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.04em;
    white-space: nowrap;
  }
  .est {
    font-size: 10px;
    letter-spacing: 0.14em;
    color: var(--muted);
    padding-left: 10px;
    border-left: 1px solid var(--hairline);
    white-space: nowrap;
  }

  /* ---- Nav ---- */
  .nav {
    display: flex;
    gap: 32px;
    font-size: 11px;
    letter-spacing: 0.14em;
  }
  .nav a {
    padding: 6px 0;
    border-bottom: 1px solid transparent;
    white-space: nowrap;
    transition: color var(--dur-fast) ease, border-color var(--dur-fast) ease;
  }
  .nav a:hover {
    color: var(--accent);
    border-bottom-color: currentColor;
  }

  /* ---- Actions: every control is 32px tall so the row lines up ---- */
  .actions {
    justify-self: end;
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .icon,
  .theme :global(.icon-btn) {
    width: 32px;
    height: 32px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 0;
    background: transparent;
    color: var(--ink);
    transition: background var(--dur-fast) ease, color var(--dur-fast) ease;
  }
  .icon svg,
  .theme :global(.icon-btn svg) {
    width: 15px;
    height: 15px;
    display: block;
  }
  .icon:hover,
  .theme :global(.icon-btn:hover) {
    background: var(--paper-2);
    color: var(--ink);
    outline: none;
  }
  .theme { display: contents; }

  .divider {
    width: 1px;
    height: 18px;
    margin: 0 10px 0 8px;
    background: var(--hairline);
  }

  .sign-in {
    display: inline-flex;
    align-items: center;
    height: 32px;
    padding: 0 14px;
    font-size: 11px;
    letter-spacing: 0.14em;
    border: 1px solid var(--ink);
    white-space: nowrap;
    transition: background var(--dur-fast) ease, color var(--dur-fast) ease;
  }
  .sign-in:hover {
    background: var(--ink);
    color: var(--paper);
  }

  .masthead a:focus-visible,
  .theme :global(.icon-btn:focus-visible) {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  /* ---- Narrow: nav drops to its own scrollable row ---- */
  @media (max-width: 900px) {
    .bar {
      grid-template-columns: 1fr auto;
      grid-template-areas:
        "brand actions"
        "nav nav";
      row-gap: 0;
      min-height: 0;
      padding-top: 12px;
    }
    .wordmark { grid-area: brand; }
    .actions { grid-area: actions; }
    .nav {
      grid-area: nav;
      margin-top: 12px;
      padding: 4px 0;
      border-top: 1px solid var(--hairline);
      gap: 24px;
      overflow-x: auto;
      scrollbar-width: none;
    }
    .nav::-webkit-scrollbar { display: none; }
  }

  @media (max-width: 520px) {
    .est { display: none; }
    .icon { display: none; }
    .divider { margin: 0 8px 0 4px; }
  }
</style>
