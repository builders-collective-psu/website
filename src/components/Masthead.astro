---
import ThemeToggle from "./ui/ThemeToggle.astro";

interface SiteData {
  name: string;
  established: string;
  nav: { label: string; href: string }[];
}

interface StatsData {
  nextEvent: { name: string; daysOut: number };
}

interface Props {
  site: SiteData;
  stats: StatsData;
}

const { site } = Astro.props;
// Uncomment alongside the next-event pill below.
// const next = Astro.props.stats.nextEvent;
---

<header class="masthead rule-b" aria-label="Site header">
  <div class="wrap row">
    <a class="wordmark upper" href="/">
      {site.name}
      <span class="est font-mono">EST. {site.established}</span>
    </a>

    {/* Next-event pill — re-enable with the `next` const above.
    <span
      class="pill font-mono upper"
      aria-label={`Next event: ${next.name} in ${next.daysOut} days`}
    >
      <span class="dot" aria-hidden="true"></span>
      NEXT: {next.name.toUpperCase()} · {next.daysOut} DAYS
    </span>
    */}

    <ThemeToggle />

    <nav class="nav font-mono upper" aria-label="Main navigation">
      {site.nav.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>
  </div>
</header>

<style>
  .masthead {
    padding: 14px 0;
    background: var(--paper);
  }
  .row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    flex-wrap: wrap;
  }

  .wordmark {
    display: inline-flex;
    align-items: baseline;
    gap: 10px;
    font-size: 15px;
    font-weight: 700;
    letter-spacing: 0.04em;
  }
  .wordmark .est {
    font-size: 11px;
    font-weight: 400;
    letter-spacing: 0.12em;
    color: var(--muted);
  }

  .pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 4px 10px;
    border: 1px solid var(--ink);
    font-size: 11px;
    letter-spacing: 0.14em;
    background: var(--paper);
  }

  .dot {
    width: 8px;
    height: 8px;
    background: var(--accent);
    border-radius: 999px;
    display: inline-block;
  }

  .nav {
    display: flex;
    gap: 28px;
    font-size: 12px;
    letter-spacing: 0.12em;
  }

  .nav a {
    transition: color var(--dur-fast) ease;
  }

  .nav a:hover,
  .nav a:focus-visible {
    color: var(--accent);
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  @media (max-width: 720px) {
    .row { gap: 12px; }
    .nav { gap: 18px; font-size: 11px; }
    .pill { order: 3; }
  }
</style>
