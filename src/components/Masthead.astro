---
import ThemeToggle from "./ui/ThemeToggle.astro";

interface SiteData {
  name: string;
  established: string;
  nav: { label: string; href: string }[];
  social: { linkedin?: string; github?: string };
}

interface StatsData {
  nextEvent: { name: string; daysOut: number };
}

interface Props {
  site: SiteData;
  stats: StatsData;
}

const { site } = Astro.props;
// Uncomment alongside the next-event pill below.
// const next = Astro.props.stats.nextEvent;
---

<header class="masthead rule-b" aria-label="Site header">
  <div class="wrap row">
    <a class="wordmark upper" href="/">
      {site.name}
      <span class="est font-mono">EST. {site.established}</span>
    </a>

    {/* Next-event pill — re-enable with the `next` const above.
    <span
      class="pill font-mono upper"
      aria-label={`Next event: ${next.name} in ${next.daysOut} days`}
    >
      <span class="dot" aria-hidden="true"></span>
      NEXT: {next.name.toUpperCase()} · {next.daysOut} DAYS
    </span>
    */}

    <div class="right">
      <nav class="nav font-mono upper" aria-label="Main navigation">
        {site.nav.map((item) => <a href={item.href}>{item.label}</a>)}
      </nav>

      <div class="tools">
        {site.social.linkedin && (
          <a
            class="icon-btn"
            href={site.social.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Builders Collective on LinkedIn"
            title="LinkedIn"
          >
            <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false" fill="currentColor">
              <path d="M3.6 5.5H.9V15h2.7V5.5ZM2.25 1a1.6 1.6 0 1 0 0 3.2 1.6 1.6 0 0 0 0-3.2ZM15 9.6c0-2.6-1.4-3.8-3.2-3.8-1.5 0-2.2.8-2.5 1.4V5.5H6.6V15h2.7V9.7c0-1.1.5-1.8 1.5-1.8s1.5.7 1.5 1.8V15H15V9.6Z" />
            </svg>
          </a>
        )}

        {site.social.github && (
          <a
            class="icon-btn"
            href={site.social.github}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Builders Collective on GitHub"
            title="GitHub"
          >
            <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false" fill="currentColor">
              <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z" />
            </svg>
          </a>
        )}

        <ThemeToggle />
      </div>
    </div>
  </div>
</header>

<style>
  .masthead {
    padding: 14px 0;
    background: var(--paper);
  }
  .row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    flex-wrap: wrap;
  }

  .wordmark {
    display: inline-flex;
    align-items: baseline;
    gap: 10px;
    font-size: 15px;
    font-weight: 700;
    letter-spacing: 0.04em;
  }
  .wordmark .est {
    font-size: 11px;
    font-weight: 400;
    letter-spacing: 0.12em;
    color: var(--muted);
  }

  .pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 4px 10px;
    border: 1px solid var(--ink);
    font-size: 11px;
    letter-spacing: 0.14em;
    background: var(--paper);
  }

  .dot {
    width: 8px;
    height: 8px;
    background: var(--accent);
    border-radius: 999px;
    display: inline-block;
  }

  .right {
    display: flex;
    align-items: center;
    gap: 24px;
    flex-wrap: wrap;
  }

  .tools {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .nav {
    display: flex;
    gap: 28px;
    font-size: 12px;
    letter-spacing: 0.12em;
  }

  .nav a {
    transition: color var(--dur-fast) ease;
  }

  .nav a:hover,
  .nav a:focus-visible {
    color: var(--accent);
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  @media (max-width: 720px) {
    .row { gap: 12px; }
    .right { gap: 14px; }
    .nav { gap: 18px; font-size: 11px; }
    .pill { order: 3; }
  }
</style>
