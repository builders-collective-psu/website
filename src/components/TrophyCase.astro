---
import SectionHeader from "./ui/SectionHeader.astro";

/**
 * Wins, straight from the platform: every recap logged with won = true.
 *
 * There is no build-time fallback here on purpose. The old trophies.json was
 * placeholder data, and showing invented wins when the API is unreachable is
 * worse than showing nothing — so the section stays hidden until real wins
 * arrive.
 */
interface Props {
  endpoint?: string;
}

const { endpoint = "/api/recaps" } = Astro.props;
---

<section class="sec" id="trophies" aria-labelledby="trophies-heading" hidden data-trophies>
  <div class="wrap">
    <SectionHeader
      title="Trophy Case"
      meta='<span data-stat="wins">—</span> FIRST-PLACE FINISHES · <span data-stat="prizeTotal">—</span> IN PRIZES'
      id="trophies-heading"
    />
    <div class="trophy-grid" data-trophy-grid></div>
  </div>
</section>

<script is:inline define:vars={{ endpoint }}>
  (function () {
    const section = document.querySelector("[data-trophies]");
    const grid = document.querySelector("[data-trophy-grid]");
    if (!grid) return;

    // Shared with the recap feed and gallery so the page makes one request.
    window.__recaps =
      window.__recaps ||
      fetch(endpoint, { headers: { accept: "application/json" } }).then((response) => {
        if (!response.ok) throw new Error(`recaps HTTP ${response.status}`);
        return response.json();
      });

    const el = (tag, className, text) => {
      const node = document.createElement(tag);
      if (className) node.className = className;
      if (text !== undefined && text !== null) node.textContent = String(text);
      return node;
    };

    const shortDate = (iso) => {
      const date = new Date(iso);
      if (Number.isNaN(date.getTime())) return "";
      return `${String(date.getMonth() + 1).padStart(2, "0")} / ${String(date.getFullYear()).slice(2)}`;
    };

    const money = (cents) =>
      typeof cents === "number" && cents > 0
        ? `$${Math.round(cents / 100).toLocaleString("en-US")}`
        : null;

    function renderWin(win) {
      const article = el("article", "trophy");
      article.appendChild(el("div", "t-date font-mono", shortDate(win.createdAt)));

      const body = el("div", "t-body");
      body.appendChild(el("h3", null, win.event));

      const detail = [win.track, win.team].filter(Boolean).join(" · ");
      if (detail) body.appendChild(el("div", "where font-mono", detail));

      const people = (win.people || []).join(", ");
      if (people) body.appendChild(el("p", null, people));

      const cash = money(win.prizeCents);
      const prizeLine = [cash, win.prizeName].filter(Boolean).join(" + ");
      if (prizeLine) body.appendChild(el("div", "t-prize font-mono", `↳ ${prizeLine}`));

      article.appendChild(body);
      article.appendChild(el("div", "t-tag font-mono upper", win.placement || "★ WIN"));
      return article;
    }

    window.__recaps
      .then((data) => {
        const wins = Array.isArray(data.wins) ? data.wins : [];
        if (!wins.length) return;
        wins.forEach((win) => grid.appendChild(renderWin(win)));
        section?.removeAttribute("hidden");
      })
      .catch(() => {
        /* endpoint missing or upstream down — section stays hidden */
      });
  })();
</script>

<style>
  .sec {
    padding: 72px 0;
    border-bottom: 1.5px solid var(--ink);
  }
  .sec[hidden] { display: none; }

  .trophy-grid {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: 0;
    border-top: 1.5px solid var(--ink);
  }

  .trophy-grid :global(.trophy) {
    grid-column: span 6;
    border-bottom: 1.5px solid var(--ink);
    border-right: 1.5px solid var(--ink);
    padding: 28px 24px 24px;
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 20px;
    align-items: start;
    transition: background var(--dur-normal) ease;
  }
  .trophy-grid :global(.trophy:nth-child(2n)) { border-right: none; }
  .trophy-grid :global(.trophy:hover) { background: var(--paper-2); }
  .trophy-grid :global(.trophy:hover .t-tag) {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--paper);
  }

  .trophy-grid :global(.t-date) {
    font-size: 12px;
    letter-spacing: 0.08em;
    border: 1px solid var(--ink);
    padding: 6px 8px;
    line-height: 1;
    align-self: start;
    white-space: nowrap;
  }

  .trophy-grid :global(.t-body h3) {
    font-size: 28px;
    font-weight: 700;
    letter-spacing: -0.02em;
    margin: 0 0 4px;
    line-height: 1.05;
  }
  .trophy-grid :global(.t-body .where) {
    font-size: 12px;
    color: var(--muted);
    letter-spacing: 0.04em;
  }
  .trophy-grid :global(.t-body p) {
    font-size: 15px;
    line-height: 1.4;
    margin: 12px 0 0;
    max-width: 44ch;
  }

  .trophy-grid :global(.t-tag) {
    font-size: 11px;
    letter-spacing: 0.14em;
    background: var(--ink);
    color: var(--paper);
    padding: 5px 9px;
    border: 1px solid var(--ink);
    align-self: start;
    white-space: nowrap;
    transition: background var(--dur-fast) ease, border-color var(--dur-fast) ease,
      color var(--dur-fast) ease;
  }

  .trophy-grid :global(.t-prize) {
    font-size: 12px;
    color: var(--accent);
    font-weight: 700;
    margin-top: 10px;
    letter-spacing: 0.04em;
  }

  @media (max-width: 720px) {
    .trophy-grid :global(.trophy) {
      grid-column: span 12;
      border-right: none;
      grid-template-columns: auto 1fr;
      gap: 16px;
    }
    .trophy-grid :global(.trophy .t-tag) {
      grid-column: 2;
      justify-self: start;
      margin-top: 4px;
    }
  }
</style>
