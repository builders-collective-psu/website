---
import SectionHeader from "./ui/SectionHeader.astro";
import { REAL_DATA } from "@lib/flags";
import trophies from "@data/trophies.json";
import log from "@data/log.json";
import HackathonLog from "./HackathonLog.astro";

/**
 * Wins.
 *
 * With REAL_DATA set, every recap logged on the platform with won = true,
 * fetched after paint; the section stays hidden until real wins arrive,
 * because inventing wins when the API is down is worse than showing nothing.
 *
 * Without it, the checked-in mock trophies render at build time and nothing
 * is fetched.
 */
interface Props {
  endpoint?: string;
}

const { endpoint = "/api/recaps" } = Astro.props;

const mockWins = trophies
  .filter((t) => t.place === 1)
  .sort((a, b) => (a.date < b.date ? 1 : -1));

const mockPrize = mockWins.reduce((sum, t) => sum + (t.prize?.cash ?? 0), 0);
const fmtCash = (n: number) =>
  n >= 1000 ? `$${(n / 1000).toFixed(n % 1000 === 0 ? 0 : 1)}K` : `$${n}`;

const meta = REAL_DATA
  ? '<span data-stat="teamWins" data-stat-guess="30">—</span> FIRST-PLACE FINISHES · <span data-stat="prizeTotal" data-stat-prefix="$" data-stat-guess="2000">—</span> IN PRIZES'
  : `${mockWins.length} FIRST-PLACE FINISHES · $${mockPrize.toLocaleString("en-US")} IN PRIZES`;
---

<section class="sec" id="trophies" aria-labelledby="trophies-heading" hidden={REAL_DATA} data-trophies>
  <div class="wrap">
    <p class="section-divider font-mono upper">The collective / Our track record</p>
    <SectionHeader title="Built & Won" meta={meta} id="trophies-heading" />

    <div class="trophy-grid" data-trophy-grid>
      {
        !REAL_DATA &&
          mockWins.map((t) => (
            <article class="trophy">
              <div class="t-date font-mono">{t.dateShort}</div>
              <div class="t-body">
                <h3>{t.event}</h3>
                <div class="where font-mono">{t.where} · {t.track}</div>
                <p>{t.summary}</p>
                <div class="t-prize font-mono">
                  ↳ {fmtCash(t.prize.cash)} + {t.prize.extras}
                </div>
              </div>
              <div class="t-tag font-mono upper">★ 1ST</div>
            </article>
          ))
      }
    </div>
    {REAL_DATA && (
      <button type="button" class="trophy-toggle font-mono upper" data-trophy-toggle aria-expanded="false" hidden>
        Show all
      </button>
    )}
    {!REAL_DATA && <details class="all-results"><summary class="font-mono upper">Explore all {log.events.length} builds & results <span aria-hidden="true">↳</span></summary><HackathonLog log={log} embedded /></details>}
  </div>
</section>

{REAL_DATA && (
  <script is:inline define:vars={{ endpoint }}>
  (function () {
    const section = document.querySelector("[data-trophies]");
    const grid = document.querySelector("[data-trophy-grid]");
    if (!grid) return;

    // Shared with the recap feed and gallery so the page makes one request.
    window.__recaps =
      window.__recaps ||
      fetch(endpoint, { headers: { accept: "application/json" } }).then((response) => {
        if (!response.ok) throw new Error(`recaps HTTP ${response.status}`);
        return response.json();
      });

    const el = (tag, className, text) => {
      const node = document.createElement(tag);
      if (className) node.className = className;
      if (text !== undefined && text !== null) node.textContent = String(text);
      return node;
    };

    // "Oct 17–18, 2026" from the platform's YYYY-MM-DD start and end.
    const eventDates = (start, end) => {
      if (!start) return "";
      const parse = (iso) => {
        const [y, m, d] = String(iso).slice(0, 10).split("-").map(Number);
        return { y, m, d, date: new Date(Date.UTC(y, m - 1, d)) };
      };
      const month = (p) => p.date.toLocaleDateString("en-US", { month: "short", timeZone: "UTC" });
      const a = parse(start);
      const b = end ? parse(end) : a;
      if (Number.isNaN(a.date.getTime())) return "";
      if (a.y === b.y && a.m === b.m && a.d === b.d) return `${month(a)} ${a.d}, ${a.y}`;
      if (a.y === b.y && a.m === b.m) return `${month(a)} ${a.d}–${b.d}, ${a.y}`;
      if (a.y === b.y) return `${month(a)} ${a.d} – ${month(b)} ${b.d}, ${a.y}`;
      return `${month(a)} ${a.d}, ${a.y} – ${month(b)} ${b.d}, ${b.y}`;
    };

    const money = (cents) =>
      typeof cents === "number" && cents > 0
        ? `$${Math.round(cents / 100).toLocaleString("en-US")}`
        : null;

    // Bunker stores some names HTML-escaped (e.g. &#39;); show them plainly.
    const decoder = document.createElement("textarea");
    const plain = (text) => {
      decoder.innerHTML = text == null ? "" : String(text);
      return decoder.value;
    };

    // Colour and size step up with the count: 1, 2, 3, 4–5, 6+.
    const tier = (n) => (n >= 6 ? 5 : n >= 4 ? 4 : n);

    // One card per event. Every winning team is listed by its members, and the
    // multiplier counts wins per person, matching the hero's figure.
    function groupByEvent(wins) {
      const groups = new Map();
      wins.forEach((win) => {
        // Keyed by name, not slug: the platform has some events entered twice.
        const key = plain(win.event).toLowerCase().replace(/\s+/g, " ").trim();
        if (!groups.has(key)) groups.set(key, { event: win.event, start: null, end: null, teams: [] });
        const group = groups.get(key);
        group.teams.push(win);
        if (!group.start && win.eventStart) {
          group.start = win.eventStart;
          group.end = win.eventEnd || null;
        }
      });
      return [...groups.values()]
        .map((group) => ({
          ...group,
          count: group.teams.reduce((total, team) => total + Math.max(1, (team.people || []).length), 0),
        }))
        // Newest event first (by start, then end, then name); undated last.
        .sort(
          (a, b) =>
            String(b.start || "").localeCompare(String(a.start || "")) ||
            String(b.end || "").localeCompare(String(a.end || "")) ||
            plain(a.event).localeCompare(plain(b.event)),
        );
    }

    function renderEvent(group) {
      const article = el("article", "trophy");
      const body = el("div", "t-body");
      body.appendChild(el("h3", null, plain(group.event)));
      const when = eventDates(group.start, group.end);
      if (when) body.appendChild(el("div", "t-when font-mono upper", when));

      const teams = el("ul", "t-teams");
      group.teams.forEach((team) => {
        const item = el("li");
        const names = (team.people || []).map(plain).join(", ") || plain(team.team) || "—";
        item.appendChild(el("span", "t-names", names));
        const what = [plain(team.prizeName || team.placement || "Winner"), money(team.prizeCents)]
          .filter(Boolean)
          .join(" · ");
        item.appendChild(el("span", "t-what font-mono", what));
        teams.appendChild(item);
      });
      body.appendChild(teams);
      article.appendChild(body);

      const mult = el("div", `t-mult t-mult--${tier(group.count)} font-mono`, `${group.count}×`);
      mult.setAttribute("aria-label", `${group.count} ${group.count === 1 ? "win" : "wins"}`);
      article.appendChild(mult);
      return article;
    }

    const PREVIEW = 4;
    const toggle = document.querySelector("[data-trophy-toggle]");

    window.__recaps
      .then((data) => {
        const wins = Array.isArray(data.wins) ? data.wins : [];
        if (!wins.length) return;
        const groups = groupByEvent(wins);
        groups.forEach((group) => grid.appendChild(renderEvent(group)));

        // Collapsed by default: a preview, then the rest on request.
        if (toggle && groups.length > PREVIEW) {
          const label = () =>
            grid.classList.contains("is-collapsed") ? `Show all ${groups.length} events ↓` : "Show fewer ↑";
          grid.classList.add("is-collapsed");
          toggle.textContent = label();
          toggle.hidden = false;
          toggle.addEventListener("click", () => {
            const collapsing = !grid.classList.contains("is-collapsed");
            grid.classList.toggle("is-collapsed");
            toggle.setAttribute("aria-expanded", String(!collapsing));
            toggle.textContent = label();
            if (collapsing) section?.scrollIntoView({ block: "start" });
          });
        }
        section?.removeAttribute("hidden");
      })
      .catch(() => {
        /* endpoint missing or upstream down — section stays hidden */
      });
  })();
  </script>
)}

<style>
  .sec {
    padding: 72px 0;
    border-top: 4px solid var(--ink);
    border-bottom: 1.5px solid var(--ink);
  }
  .sec[hidden] { display: none; }
  .section-divider { color: var(--muted); font-size: 11px; letter-spacing: .14em; margin: 0 0 24px; }
  .all-results { margin-top: 32px; border-top: 1.5px solid var(--ink); }
  .all-results summary { cursor: pointer; padding: 20px 0; font-size: 12px; letter-spacing: .08em; }
  .all-results summary:hover { color: var(--accent); }
  .all-results summary:focus-visible { outline: 2px solid var(--accent); outline-offset: 4px; }

  .trophy-grid {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: 0;
    border-top: 1.5px solid var(--ink);
  }

  .trophy-grid :global(.trophy) {
    grid-column: span 6;
    border-bottom: 1.5px solid var(--ink);
    border-right: 1.5px solid var(--ink);
    padding: 28px 24px 24px;
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 20px;
    align-items: start;
    transition: background var(--dur-normal) ease;
  }
  .trophy-grid :global(.trophy:nth-child(2n)) { border-right: none; }
  .trophy-grid :global(.trophy:hover) { background: var(--paper-2); }
  .trophy-grid :global(.trophy:hover .t-tag) {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--paper);
  }

  .trophy-grid :global(.t-date) {
    font-size: 12px;
    letter-spacing: 0.08em;
    border: 1px solid var(--ink);
    padding: 6px 8px;
    line-height: 1;
    align-self: start;
    white-space: nowrap;
  }

  .trophy-grid :global(.t-body h3) {
    font-size: 28px;
    font-weight: 700;
    letter-spacing: -0.02em;
    margin: 0 0 4px;
    line-height: 1.05;
  }
  .trophy-grid :global(.t-body .where) {
    font-size: 12px;
    color: var(--muted);
    letter-spacing: 0.04em;
  }
  .trophy-grid :global(.t-body p) {
    font-size: 15px;
    line-height: 1.4;
    margin: 12px 0 0;
    max-width: 44ch;
  }

  .trophy-grid :global(.t-tag) {
    font-size: 11px;
    letter-spacing: 0.14em;
    background: var(--ink);
    color: var(--paper);
    padding: 5px 9px;
    border: 1px solid var(--ink);
    align-self: start;
    white-space: nowrap;
    transition: background var(--dur-fast) ease, border-color var(--dur-fast) ease,
      color var(--dur-fast) ease;
  }

  .trophy-grid.is-collapsed :global(.trophy:nth-child(n + 5)) { display: none; }

  .trophy-toggle {
    display: block;
    width: 100%;
    padding: 18px 0;
    font-size: 12px;
    letter-spacing: 0.1em;
    text-align: left;
    color: var(--ink);
    background: none;
    border: 0;
    border-bottom: 1.5px solid var(--ink);
    cursor: pointer;
  }
  .trophy-toggle[hidden] { display: none; }
  .trophy-toggle:hover { color: var(--accent); }
  .trophy-toggle:focus-visible { outline: 2px solid var(--accent); outline-offset: 4px; }

  .trophy-grid :global(.t-when) {
    margin-top: 6px;
    font-size: 11px;
    letter-spacing: 0.12em;
    color: var(--muted);
  }

  .trophy-grid :global(.t-teams) {
    list-style: none;
    margin: 14px 0 0;
    padding: 0;
    display: grid;
    gap: 10px;
  }
  .trophy-grid :global(.t-teams li) { display: grid; gap: 2px; }
  .trophy-grid :global(.t-names) { font-size: 15px; font-weight: 600; line-height: 1.35; }
  .trophy-grid :global(.t-what) {
    font-size: 11px;
    letter-spacing: 0.04em;
    color: var(--muted);
    line-height: 1.4;
  }

  /* Win multiplier: bigger, hotter and livelier as the count climbs. */
  .trophy-grid :global(.t-mult) {
    --tint: var(--muted);
    align-self: start;
    min-width: 2.2em;
    font-size: 40px;
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.04em;
    text-align: right;
    color: var(--tint);
    transform-origin: right center;
    animation: t-zoom 4s ease-in-out infinite;
  }
  .trophy-grid :global(.t-mult--1) { --tint: var(--muted); animation: none; }
  .trophy-grid :global(.t-mult--2) { --tint: var(--ink); }
  .trophy-grid :global(.t-mult--3) { --tint: #E0A100; }
  .trophy-grid :global(.t-mult--4) { --tint: var(--accent); }
  .trophy-grid :global(.t-mult--5) { --tint: #E5254B; text-shadow: 0 0 18px color-mix(in srgb, #E5254B 45%, transparent); }

  @keyframes t-zoom {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.12); }
  }

  @media (prefers-reduced-motion: reduce) {
    .trophy-grid :global(.t-mult) { animation: none; }
  }

  .trophy-grid :global(.t-prize) {
    font-size: 12px;
    color: var(--accent);
    font-weight: 700;
    margin-top: 10px;
    letter-spacing: 0.04em;
  }

  @media (max-width: 720px) {
    .trophy-grid :global(.trophy) {
      grid-column: span 12;
      border-right: none;
      grid-template-columns: 1fr auto;
      gap: 12px 16px;
      padding: 24px 0;
    }
    .trophy-grid :global(.trophy .t-mult) { font-size: 32px; }
  }
</style>
