---
import SectionHeader from "./ui/SectionHeader.astro";
import { REAL_DATA } from "@lib/flags";
import trophies from "@data/trophies.json";
import log from "@data/log.json";
import HackathonLog from "./HackathonLog.astro";

/**
 * Built & Won.
 *
 * With live data this is a show that plays to the page beat: events on the
 * left with their photos, and on the right one winning project at a time —
 * what it was, who built it, links — followed by the team's LinkedIn posts
 * ("larps") springing in one by one. After the last larp it moves to the next
 * winning project at that event, then to the next event. Data comes from
 * /api/builds; the section stays hidden until it arrives.
 *
 * Without live data the checked-in mock trophies render as a static list.
 */
interface Props {
  endpoint?: string;
}

const { endpoint = "/api/builds" } = Astro.props;

const mockWins = trophies.filter((t) => t.place === 1).sort((a, b) => (a.date < b.date ? 1 : -1));
const mockPrize = mockWins.reduce((sum, t) => sum + (t.prize?.cash ?? 0), 0);
const fmtCash = (n: number) => (n >= 1000 ? `$${(n / 1000).toFixed(n % 1000 === 0 ? 0 : 1)}K` : `$${n}`);

const meta = REAL_DATA
  ? '<span data-stat="teamWins" data-stat-guess="30">—</span> FIRST-PLACE FINISHES · <span data-stat="prizeTotal" data-stat-prefix="$" data-stat-guess="2000">—</span> IN PRIZES'
  : `${mockWins.length} FIRST-PLACE FINISHES · $${mockPrize.toLocaleString("en-US")} IN PRIZES`;
---

<section class="sec" id="trophies" aria-labelledby="trophies-heading" hidden={REAL_DATA} data-trophies>
  <div class="wrap">
    <p class="section-divider font-mono upper">The collective / Our track record</p>
    <SectionHeader title="Built & Won" meta={meta} id="trophies-heading" />

    {
      REAL_DATA ? (
        <div class="show" data-show>
          <div class="left">
            <ol class="events" data-events aria-label="Events we won at" />
          </div>
          <div class="right" aria-live="polite">
            <div class="post-slot" data-post />
            <div class="larp-slot" data-larp />
            <div class="progress font-mono upper" data-progress />
          </div>
        </div>
      ) : (
        <>
          <div class="mock-grid">
            {mockWins.map((t) => (
              <article class="mock">
                <div class="font-mono mock-date">{t.dateShort}</div>
                <div>
                  <h3>{t.event}</h3>
                  <div class="font-mono mock-where">
                    {t.where} · {t.track}
                  </div>
                  <p>{t.summary}</p>
                  <div class="font-mono mock-prize">
                    ↳ {fmtCash(t.prize.cash)} + {t.prize.extras}
                  </div>
                </div>
              </article>
            ))}
          </div>
          <details class="all-results">
            <summary class="font-mono upper">
              Explore all {log.events.length} builds & results <span aria-hidden="true">↳</span>
            </summary>
            <HackathonLog log={log} embedded />
          </details>
        </>
      )
    }
  </div>
</section>

{REAL_DATA && (
  <script is:inline define:vars={{ endpoint }}>
  (function () {
    const section = document.querySelector("[data-trophies]");
    const show = document.querySelector("[data-show]");
    if (!section || !show) return;
    const list = show.querySelector("[data-events]");
    const postSlot = show.querySelector("[data-post]");
    const larpSlot = show.querySelector("[data-larp]");
    const progress = show.querySelector("[data-progress]");
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    const el = (tag, className, text) => {
      const node = document.createElement(tag);
      if (className) node.className = className;
      if (text !== undefined && text !== null && text !== "") node.textContent = String(text);
      return node;
    };
    const link = (label, href) => {
      const a = el("a", "chip font-mono upper", label);
      a.href = href;
      a.target = "_blank";
      a.rel = "noopener noreferrer";
      return a;
    };
    const img = (src, alt, className) => {
      const i = el("img", className);
      i.src = src;
      i.alt = alt;
      i.loading = "lazy";
      i.referrerPolicy = "no-referrer";
      i.addEventListener("error", () => i.remove());
      return i;
    };
    const money = (cents) => (typeof cents === "number" && cents > 0 ? `$${Math.round(cents / 100).toLocaleString("en-US")}` : null);
    const fmtDates = (start, end) => {
      if (!start) return "";
      const parts = (iso) => {
        const [y, m, d] = String(iso).slice(0, 10).split("-").map(Number);
        return { y, d, mon: new Date(Date.UTC(y, m - 1, d)).toLocaleDateString("en-US", { month: "short", timeZone: "UTC" }) };
      };
      const a = parts(start);
      const b = parts(end || start);
      if (a.y !== b.y) return `${a.mon} ${a.d}, ${a.y} – ${b.mon} ${b.d}, ${b.y}`;
      if (a.mon !== b.mon) return `${a.mon} ${a.d} – ${b.mon} ${b.d}, ${a.y}`;
      if (a.d !== b.d) return `${a.mon} ${a.d}–${b.d}, ${a.y}`;
      return `${a.mon} ${a.d}, ${a.y}`;
    };
    const spring = (node) => {
      node.classList.remove("spring");
      void node.offsetWidth;
      node.classList.add("spring");
    };

    let events = [];
    let ei = 0; // event
    let pi = 0; // project at that event
    let li = -1; // larp (-1: the project card on its own)
    let beatsLeft = 0;
    let inView = false;

    // Beats each step holds for.
    const HOLD_PROJECT = 4;
    const HOLD_LARP = 5;
    const HOLD_ALONE = 7;

    // Event cards, in the original format: name, dates, every winning team by
    // its members with what they won, and the N× multiplier.
    const tier = (n) => (n >= 6 ? 5 : n >= 4 ? 4 : n);
    function renderEvents() {
      list.replaceChildren(
        ...events.map((event, i) => {
          const item = el("li", "ev");
          const card = el("article", "trophy");
          card.tabIndex = 0;
          card.setAttribute("role", "button");
          const body = el("div", "t-body");
          body.appendChild(el("h3", null, event.event));
          const when = fmtDates(event.start, event.end);
          if (when) body.appendChild(el("div", "t-when font-mono upper", when));
          const teams = el("ul", "t-teams");
          event.projects.forEach((project) => {
            const row = el("li");
            row.appendChild(el("span", "t-names", project.members.map((m) => m.name).join(", ") || project.team || "—"));
            const what = [project.prize || project.placement || "Winner", money(project.prizeCents)].filter(Boolean).join(" · ");
            row.appendChild(el("span", "t-what font-mono", what));
            teams.appendChild(row);
          });
          body.appendChild(teams);
          card.appendChild(body);
          const count = event.projects.reduce((t, p) => t + Math.max(1, p.members.length), 0);
          const mult = el("div", `t-mult t-mult--${tier(count)} font-mono`, `${count}×`);
          mult.setAttribute("aria-label", `${count} ${count === 1 ? "win" : "wins"}`);
          card.appendChild(mult);
          const pick = () => {
            goEvent(i);
            window.__sfx && window.__sfx.select();
          };
          card.addEventListener("click", pick);
          card.addEventListener("keydown", (e) => {
            if (e.key === "Enter" || e.key === " ") {
              e.preventDefault();
              pick();
            }
          });
          item.appendChild(card);
          return item;
        }),
      );
    }

    function renderProject() {
      const event = events[ei];
      const project = event.projects[pi];
      const card = el("article", "post");
      const top = el("div", "post-top font-mono upper");
      top.appendChild(el("span", "post-place", project.placement || "Winner"));
      const cash = money(project.prizeCents);
      top.appendChild(el("span", "post-event", [event.event, cash].filter(Boolean).join("  ·  ")));
      card.appendChild(top);
      card.appendChild(el("h3", "post-title", project.title || project.team || "Winning project"));
      if (project.prize && project.prize !== project.placement) card.appendChild(el("p", "post-prize font-mono", `↳ ${project.prize}`));
      if (project.summary) card.appendChild(el("p", "post-summary", project.summary));
      if (project.track) card.appendChild(el("p", "post-track font-mono upper", `Track · ${project.track}`));

      const team = el("ul", "post-team");
      project.members.forEach((m) => {
        const li = el("li", "member");
        if (m.image) li.appendChild(img(m.image, "", "avatar"));
        else li.appendChild(el("span", "avatar avatar--blank", (m.name || "?").slice(0, 1)));
        li.appendChild(el("span", "member-name", m.name));
        team.appendChild(li);
      });
      card.appendChild(team);

      const links = el("div", "post-links");
      if (project.devpost) links.appendChild(link("Devpost ↗", project.devpost));
      if (project.github) links.appendChild(link("GitHub ↗", project.github));
      if (links.childNodes.length) card.appendChild(links);

      postSlot.replaceChildren(card);
      spring(card);
    }

    function renderLarp() {
      const project = events[ei].projects[pi];
      const larp = li >= 0 ? project.larps[li] : null;
      if (!larp) {
        larpSlot.replaceChildren();
        larpSlot.classList.toggle("is-empty", true);
        return;
      }
      larpSlot.classList.remove("is-empty");
      const card = el("article", "larp");
      const head = el("div", "larp-head");
      if (larp.authorImage) head.appendChild(img(larp.authorImage, "", "avatar"));
      head.appendChild(el("span", "larp-author", larp.author));
      head.appendChild(el("span", "larp-where font-mono upper", "on LinkedIn"));
      card.appendChild(head);
      const body = el("div", "larp-body");
      if (larp.image) body.appendChild(img(larp.image, "", "larp-img"));
      if (larp.text) body.appendChild(el("p", "larp-text", larp.text));
      card.appendChild(body);
      if (larp.url) card.appendChild(link("Read post ↗", larp.url));
      larpSlot.replaceChildren(card);
      spring(card);
    }

    function renderProgress() {
      const event = events[ei];
      const project = event.projects[pi];
      const bits = [`Project ${pi + 1}/${event.projects.length}`];
      if (project.larps.length) bits.push(li >= 0 ? `Post ${li + 1}/${project.larps.length}` : `${project.larps.length} posts`);
      progress.textContent = bits.join("  ·  ");
      [...list.children].forEach((item, i) => item.classList.toggle("is-on", i === ei));
      const active = list.children[ei];
      if (active) {
        // Scroll the list, not the page.
        const top = active.offsetTop - list.clientHeight / 2 + active.clientHeight / 2;
        list.scrollTo({ top, behavior: reduced ? "auto" : "smooth" });
      }
    }

    function hold() {
      const project = events[ei].projects[pi];
      if (li >= 0) return HOLD_LARP;
      return project.larps.length ? HOLD_PROJECT : HOLD_ALONE;
    }

    function goEvent(i) {
      ei = (i + events.length) % events.length;
      pi = 0;
      li = -1;
      renderProject();
      renderLarp();
      renderProgress();
      beatsLeft = hold();
    }

    function step() {
      const event = events[ei];
      const project = event.projects[pi];
      if (li + 1 < project.larps.length) {
        li++;
        renderLarp();
        renderProgress();
      } else if (pi + 1 < event.projects.length) {
        pi++;
        li = -1;
        renderProject();
        renderLarp();
        renderProgress();
      } else {
        goEvent(ei + 1);
        window.__sfx && window.__sfx.select();
        return;
      }
      window.__sfx && window.__sfx.select();
      beatsLeft = hold();
    }

    // Hovering the show pauses it, so people can read.
    let paused = false;
    show.addEventListener("pointerenter", () => (paused = true));
    show.addEventListener("pointerleave", () => (paused = false));

    window.addEventListener("fx:beat", (e) => {
      if (!events.length || !inView || paused || reduced) return;
      if (--beatsLeft <= 0) step();
    });

    new IntersectionObserver((entries) => {
      inView = entries.some((entry) => entry.isIntersecting);
    }, { threshold: 0.3 }).observe(show);

    window.__builds =
      window.__builds ||
      fetch(endpoint, { headers: { accept: "application/json" } }).then((response) => {
        if (!response.ok) throw new Error(`builds HTTP ${response.status}`);
        return response.json();
      });

    window.__builds
      .then((data) => {
        events = (Array.isArray(data.events) ? data.events : []).filter((e) => e.projects && e.projects.length);
        if (!events.length) return;
        renderEvents();
        goEvent(0);
        section.removeAttribute("hidden");
      })
      .catch(() => {
        /* endpoint missing or upstream down — section stays hidden */
      });
  })();
  </script>
)}

<style>
  .sec {
    padding: 72px 0;
    border-top: 4px solid var(--ink);
    border-bottom: 1.5px solid var(--ink);
  }
  .sec[hidden] { display: none; }
  .section-divider { color: var(--muted); font-size: 11px; letter-spacing: 0.14em; margin: 0 0 24px; }

  /* ---------- The show ---------- */
  .show {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    border-top: 1.5px solid var(--ink);
    border-bottom: 1.5px solid var(--ink);
  }
  .left { border-right: 1.5px solid var(--ink); min-height: 0; padding-right: 24px; }
  .right { padding: 28px 0 28px 32px; display: grid; gap: 18px; align-content: start; min-height: 640px; }

  .events {
    position: relative;
    list-style: none;
    margin: 0;
    padding: 0;
    max-height: 720px;
    overflow-y: auto;
    scrollbar-width: thin;
  }

  /* Event cards (original format) */
  .events :global(.trophy) {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 16px;
    align-items: start;
    padding: 22px 20px 20px 0;
    border-bottom: 1.5px solid var(--ink);
    cursor: pointer;
    transition: background var(--dur-normal) ease, padding var(--dur-normal) ease;
  }
  .events :global(.trophy:hover) { background: var(--paper-2); }
  .events :global(.ev.is-on .trophy) {
    background: var(--paper-2);
    padding-left: 16px;
    box-shadow: inset 4px 0 0 var(--accent);
  }
  .events :global(.trophy h3) {
    margin: 0;
    font-size: 24px;
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.05;
  }
  .events :global(.t-when) { margin-top: 6px; font-size: 11px; letter-spacing: 0.12em; color: var(--muted); }
  .events :global(.t-teams) { list-style: none; margin: 12px 0 0; padding: 0; display: grid; gap: 8px; }
  .events :global(.t-teams li) { display: grid; gap: 2px; }
  .events :global(.t-names) { font-size: 14px; font-weight: 600; line-height: 1.35; }
  .events :global(.t-what) { font-size: 11px; letter-spacing: 0.04em; color: var(--muted); line-height: 1.4; }

  .events :global(.t-mult) {
    --tint: var(--muted);
    min-width: 2.2em;
    font-size: 36px;
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.04em;
    text-align: right;
    color: var(--tint);
    transform-origin: right center;
    animation: t-zoom 4s ease-in-out infinite;
  }
  .events :global(.t-mult--1) { animation: none; }
  .events :global(.t-mult--2) { --tint: var(--ink); }
  .events :global(.t-mult--3) { --tint: #e0a100; }
  .events :global(.t-mult--4) { --tint: var(--accent); }
  .events :global(.t-mult--5) { --tint: #e5254b; text-shadow: 0 0 18px color-mix(in srgb, #e5254b 45%, transparent); }
  @keyframes t-zoom {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.12); }
  }

  /* Project card */
  .post-slot :global(.post) {
    border: 1.5px solid var(--ink);
    padding: 24px;
    background: var(--paper);
    box-shadow: 8px 8px 0 var(--ink);
  }
  .post-slot :global(.post-top) {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
    font-size: 11px;
    letter-spacing: 0.12em;
  }
  .post-slot :global(.post-place) { background: var(--accent); color: #0b1220; padding: 3px 8px; font-weight: 700; }
  .post-slot :global(.post-event) { color: var(--muted); }
  .post-slot :global(.post-title) {
    margin: 16px 0 6px;
    font-size: clamp(28px, 3.2vw, 44px);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1;
  }
  .post-slot :global(.post-prize) { margin: 0; font-size: 12px; color: var(--accent); font-weight: 700; }
  .post-slot :global(.post-summary) { margin: 14px 0 0; font-size: 17px; line-height: 1.4; max-width: 56ch; }
  .post-slot :global(.post-track) { margin: 12px 0 0; font-size: 10px; letter-spacing: 0.14em; color: var(--muted); }
  .post-slot :global(.post-team) { list-style: none; margin: 18px 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 10px 18px; }
  .post-slot :global(.member) { display: inline-flex; align-items: center; gap: 8px; font-size: 14px; font-weight: 600; }
  .show :global(.avatar) {
    width: 28px;
    height: 28px;
    border-radius: 999px;
    object-fit: cover;
    border: 1px solid var(--ink);
    flex: none;
  }
  .show :global(.avatar--blank) {
    display: inline-grid;
    place-items: center;
    font-size: 12px;
    font-weight: 700;
    background: var(--paper-2);
  }
  .post-slot :global(.post-links), .larp-slot :global(.larp) { display: flex; gap: 10px; flex-wrap: wrap; }
  .post-slot :global(.post-links) { margin-top: 18px; }
  .show :global(.chip) {
    display: inline-flex;
    padding: 6px 10px;
    font-size: 10px;
    letter-spacing: 0.14em;
    border: 1px solid var(--ink);
  }
  .show :global(.chip:hover) { background: var(--ink); color: var(--paper); }

  /* Larp card, under the project */
  .larp-slot { min-height: 200px; }
  .larp-slot :global(.larp) {
    flex-direction: column;
    gap: 12px;
    margin-left: 28px;
    padding: 18px;
    border: 1px solid var(--ink);
    border-left: 4px solid var(--accent);
    background: var(--paper-2);
  }
  .larp-slot :global(.larp-head) { display: flex; align-items: center; gap: 10px; }
  .larp-slot :global(.larp-author) { font-weight: 700; font-size: 14px; }
  .larp-slot :global(.larp-where) { font-size: 10px; letter-spacing: 0.14em; color: var(--muted); }
  .larp-slot :global(.larp-body) { display: grid; grid-template-columns: auto 1fr; gap: 14px; align-items: start; }
  .larp-slot :global(.larp-img) { width: 120px; height: 90px; object-fit: cover; border: 1px solid var(--ink); }
  .larp-slot :global(.larp-text) { margin: 0; font-size: 14px; line-height: 1.45; grid-column: auto; }
  .larp-slot :global(.larp-body:not(:has(.larp-img)) .larp-text) { grid-column: 1 / -1; }

  .progress { font-size: 10px; letter-spacing: 0.14em; color: var(--muted); }

  /* Springs in, game-card style. */
  .show :global(.spring) { animation: spring-in 520ms cubic-bezier(0.34, 1.56, 0.64, 1) both; }
  @keyframes spring-in {
    0% { opacity: 0; transform: translateY(26px) scale(0.94) rotate(-1deg); }
    60% { opacity: 1; }
    100% { opacity: 1; transform: none; }
  }

  /* ---------- Mock (no live data) ---------- */
  .mock-grid { display: grid; grid-template-columns: 1fr 1fr; border-top: 1.5px solid var(--ink); }
  .mock { display: grid; grid-template-columns: auto 1fr; gap: 20px; padding: 24px; border-bottom: 1.5px solid var(--ink); }
  .mock:nth-child(odd) { border-right: 1.5px solid var(--ink); }
  .mock h3 { margin: 0 0 4px; font-size: 26px; letter-spacing: -0.02em; }
  .mock-date, .mock-where { font-size: 12px; color: var(--muted); }
  .mock p { margin: 10px 0 0; }
  .mock-prize { margin-top: 10px; font-size: 12px; color: var(--accent); font-weight: 700; }
  .all-results { margin-top: 32px; border-top: 1.5px solid var(--ink); }
  .all-results summary { cursor: pointer; padding: 20px 0; font-size: 12px; letter-spacing: 0.08em; }

  @media (max-width: 960px) {
    .show { grid-template-columns: 1fr; }
    .left { border-right: 0; border-bottom: 1.5px solid var(--ink); }
    .left { padding-right: 0; }
    .events { max-height: 360px; }
    .right { padding: 24px 0; min-height: 0; }
    .larp-slot :global(.larp) { margin-left: 12px; }
    .mock-grid { grid-template-columns: 1fr; }
    .mock:nth-child(odd) { border-right: 0; }
  }
  @media (max-width: 560px) {
    .larp-slot :global(.larp-body) { grid-template-columns: 1fr; }
    .larp-slot :global(.larp-img) { width: 100%; height: auto; aspect-ratio: 16 / 9; }
  }

  @media (prefers-reduced-motion: reduce) {
    .show :global(.spring), .events :global(.t-mult) { animation: none; }
  }
</style>
