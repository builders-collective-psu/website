---
/**
 * Site-wide game feel: soft synthesized UI sounds and springy interactions.
 *
 * Sounds are generated with Web Audio (no files) and kept quiet. Browsers only
 * allow audio after a user gesture, so nothing plays until the first click or
 * key press. The speaker button in the masthead mutes them; the choice is
 * remembered per browser. Other components play sounds through window.__sfx.
 */
---

<div class="fx-reticle" data-fx-reticle aria-hidden="true">
  <span class="fx-c fx-tl"></span><span class="fx-c fx-tr"></span>
  <span class="fx-c fx-bl"></span><span class="fx-c fx-br"></span>
</div>

<script is:inline>
  (function () {
    const KEY = "bc-sfx";
    let muted = false;
    try {
      muted = localStorage.getItem(KEY) === "off";
    } catch (e) {}

    // Volume: six discrete steps, 0 = silent.
    const LEVELS = [0, 0.15, 0.3, 0.5, 0.75, 1];
    let volume = 3;
    try {
      const raw = localStorage.getItem("bc-vol");
      const saved = raw === null ? NaN : Number(raw);
      if (Number.isInteger(saved) && saved >= 0 && saved < LEVELS.length) volume = saved;
    } catch (e) {}

    let ctx = null;
    let meter = null;
    let master = null;
    const ready = () => {
      if (ctx) return ctx;
      const AC = window.AudioContext || window.webkitAudioContext;
      if (!AC) return null;
      ctx = new AC();
      master = ctx.createGain();
      master.gain.value = LEVELS[volume];
      // A limiter after the master so louder levels never clip.
      const limiter = ctx.createDynamicsCompressor();
      limiter.threshold.value = -10;
      limiter.knee.value = 6;
      limiter.ratio.value = 12;
      limiter.attack.value = 0.003;
      limiter.release.value = 0.15;
      master.connect(limiter).connect(ctx.destination);
      meter = ctx.createAnalyser();
      meter.fftSize = 2048;
      limiter.connect(meter);
      return ctx;
    };
    let unlocked = false;
    const unlock = () => {
      unlocked = true;
      const c = ready();
      if (c && c.state === "suspended") c.resume();
    };
    window.addEventListener("pointerdown", unlock, { once: false, passive: true });
    window.addEventListener("keydown", unlock, { passive: true });

    // One short enveloped tone. Volumes stay well under 0.1.
    function blip(freq, { type = "sine", dur = 0.06, vol = 0.04, slide = 0 } = {}) {
      if (muted || !unlocked || !ready() || document.hidden) return;
      const t = ctx.currentTime;
      const osc = ctx.createOscillator();
      const gain = ctx.createGain();
      osc.type = type;
      osc.frequency.setValueAtTime(freq, t);
      if (slide) osc.frequency.exponentialRampToValueAtTime(freq * slide, t + dur);
      gain.gain.setValueAtTime(0.0001, t);
      gain.gain.exponentialRampToValueAtTime(vol, t + 0.005);
      gain.gain.exponentialRampToValueAtTime(0.0001, t + dur);
      osc.connect(gain).connect(master);
      osc.start(t);
      osc.stop(t + dur + 0.02);
    }

    let lastHover = 0;
    window.__sfx = {
      // Bigger things sound lower.
      hover(size = 40) {
        const now = performance.now();
        if (now - lastHover < 60) return;
        lastHover = now;
        const pitch = Math.max(520, Math.min(1500, 1500 - Math.sqrt(size) * 22));
        blip(pitch, { dur: 0.045, vol: 0.07 });
      },
      click() {
        blip(520, { type: "triangle", dur: 0.1, vol: 0.16, slide: 1.6 });
      },
      beat(down) {
        blip(down ? 330 : 660, { type: "triangle", dur: down ? 0.08 : 0.05, vol: down ? 0.1 : 0.06 });
      },
      // Impact: a short filtered noise hit over a low thud.
      clash() {
        if (muted || !unlocked || !ready() || document.hidden) return;
        const t = ctx.currentTime;
        const len = Math.floor(ctx.sampleRate * 0.12);
        const buffer = ctx.createBuffer(1, len, ctx.sampleRate);
        const data = buffer.getChannelData(0);
        for (let i = 0; i < len; i++) data[i] = (Math.random() * 2 - 1) * Math.pow(1 - i / len, 3);
        const noise = ctx.createBufferSource();
        noise.buffer = buffer;
        const band = ctx.createBiquadFilter();
        band.type = "bandpass";
        band.frequency.value = 1800;
        const gain = ctx.createGain();
        gain.gain.value = 0.2;
        noise.connect(band).connect(gain).connect(master);
        noise.start(t);
        blip(180, { type: "triangle", dur: 0.18, vol: 0.2, slide: 0.5 });
      },
      select() {
        blip(990, { dur: 0.06, vol: 0.08, slide: 1.25 });
      },
    };

    // ---------- Beat clock ----------
    // One shared beat for the whole page (640 ms, about 94 bpm). Components
    // listen for "fx:beat" with { n, down }. When audio is running the music
    // is scheduled on the same grid, slightly ahead, so they stay in step.
    const BEAT = 640;
    let beatIndex = 0;
    let nextBeat = performance.now() + BEAT;
    window.__beatPeriod = BEAT;

    // ---------- Jazz loop ----------
    // ii–V–I–VI in C, one chord a bar: walking bass, a brushed ride with a
    // swung skip, and soft comping stabs. All synthesized, all quiet.
    const MUSIC_KEY = "bc-music";
    let musicOn = true;
    try {
      musicOn = localStorage.getItem(MUSIC_KEY) !== "off";
    } catch (e) {}
    let musicBus = null;
    const bus = () => {
      if (!musicBus && ready()) {
        musicBus = ctx.createGain();
        musicBus.gain.value = 0.85;
        musicBus.connect(master);
      }
      return musicBus;
    };
    const hz = (midi) => 440 * Math.pow(2, (midi - 69) / 12);
    const CHORDS = [
      { root: 38, tones: [0, 3, 7, 10], voicing: [65, 72, 76] }, // Dm7:  F C E
      { root: 43, tones: [0, 4, 7, 10], voicing: [65, 71, 76] }, // G7:   F B E
      { root: 36, tones: [0, 4, 7, 11], voicing: [64, 71, 74] }, // Cmaj7: E B D
      { root: 45, tones: [0, 4, 7, 10], voicing: [61, 67, 71] }, // A7:   C# G B
    ];
    let noiseBuffer = null;
    const noise = () => {
      if (!noiseBuffer) {
        noiseBuffer = ctx.createBuffer(1, ctx.sampleRate * 0.3, ctx.sampleRate);
        const d = noiseBuffer.getChannelData(0);
        for (let i = 0; i < d.length; i++) d[i] = Math.random() * 2 - 1;
      }
      return noiseBuffer;
    };
    function tone(at, freq, { type = "sine", dur = 0.3, vol = 0.03, cutoff = 0 } = {}) {
      const osc = ctx.createOscillator();
      const gain = ctx.createGain();
      osc.type = type;
      osc.frequency.setValueAtTime(freq, at);
      gain.gain.setValueAtTime(0.0001, at);
      gain.gain.exponentialRampToValueAtTime(vol, at + 0.012);
      gain.gain.exponentialRampToValueAtTime(0.0001, at + dur);
      let out = osc.connect(gain);
      if (cutoff) {
        const lp = ctx.createBiquadFilter();
        lp.type = "lowpass";
        lp.frequency.value = cutoff;
        out = out.connect(lp);
      }
      out.connect(bus());
      osc.start(at);
      osc.stop(at + dur + 0.05);
    }
    function brush(at, vol, dur = 0.09, freq = 7000) {
      const src = ctx.createBufferSource();
      src.buffer = noise();
      const hp = ctx.createBiquadFilter();
      hp.type = "highpass";
      hp.frequency.value = freq;
      const gain = ctx.createGain();
      gain.gain.setValueAtTime(vol, at);
      gain.gain.exponentialRampToValueAtTime(0.0001, at + dur);
      src.connect(hp).connect(gain).connect(bus());
      src.start(at);
      src.stop(at + dur + 0.02);
    }
    // Announce each pitched note at the moment it sounds ("fx:note"), so the
    // page can draw one note per note.
    function announce(at, midi, kind) {
      const delay = Math.max(0, (at - ctx.currentTime) * 1000);
      setTimeout(() => window.dispatchEvent(new CustomEvent("fx:note", { detail: { midi, kind } })), delay);
    }

    function playBeat(n, at) {
      const beatSec = BEAT / 1000;
      const bar = Math.floor(n / 4) % CHORDS.length;
      const pos = n % 4;
      const chord = CHORDS[bar];
      const next = CHORDS[(bar + 1) % CHORDS.length];
      // Walking bass: root, chord tone, fifth, then a half-step approach.
      const bass = [
        chord.root,
        chord.root + chord.tones[1 + ((n >> 2) % 2)],
        chord.root + 7,
        next.root + (n % 8 < 4 ? -1 : 1),
      ][pos];
      // Up an octave from a real upright so laptop speakers can play it.
      tone(at, hz(bass + 12), { type: "triangle", dur: beatSec * 0.95, vol: 0.24, cutoff: 1600 });
      announce(at, bass + 12, "bass");
      // Ride on every beat, swung skip note after 2 and 4, foot hat on 2 and 4.
      brush(at, 0.07);
      if (pos === 1 || pos === 3) {
        brush(at + beatSec * (2 / 3), 0.045);
        brush(at, 0.05, 0.05, 4000);
      }
      // Comping: a soft stab on the "and" of 2, sometimes on 4.
      const stab = pos === 1 ? at + beatSec * (2 / 3) : pos === 3 && bar % 2 === 0 ? at : null;
      if (stab !== null) {
        chord.voicing.forEach((m, i) => {
          tone(stab + i * 0.006, hz(m), { type: "triangle", dur: 0.42, vol: 0.06, cutoff: 2200 });
          announce(stab + i * 0.006, m, "chord");
        });
      }
    }

    const musicPlaying = () => musicOn && !muted && unlocked && !!ctx && !document.hidden;

    window.__music = {
      // True only while the loop is actually sounding (audio unlocked, not muted).
      get playing() {
        return musicPlaying() && volume > 0;
      },
      get on() {
        return musicOn && !muted;
      },
      toggle() {
        musicOn = !musicOn;
        try {
          localStorage.setItem(MUSIC_KEY, musicOn ? "on" : "off");
        } catch (e) {}
        window.dispatchEvent(new CustomEvent("fx:music", { detail: window.__music.on }));
        return musicOn;
      },
    };

    setInterval(() => {
      const now = performance.now();
      while (nextBeat < now + 120) {
        const n = beatIndex++;
        const at = nextBeat;
        if (musicPlaying()) playBeat(n, ctx.currentTime + Math.max(0, (at - now) / 1000));
        setTimeout(() => {
          if (!document.hidden) window.dispatchEvent(new CustomEvent("fx:beat", { detail: { n, down: n % 4 === 0 } }));
        }, Math.max(0, at - now));
        nextBeat += BEAT;
      }
    }, 25);

    // "Awake" = sound is actually on: the visitor has clicked or pressed a key
    // (so the browser allows audio), it is not muted, and volume is above 0.
    window.__soundAwake = () => unlocked && !muted && volume > 0;

    // Read-only snapshot of the audio engine, for debugging in the console.
    window.__audioState = () => ({
      context: ctx ? ctx.state : "not created",
      unlocked,
      muted,
      volume,
      gain: master ? master.gain.value : null,
      music: musicOn,
      // Loudest sample in the last ~40 ms, in dBFS.
      peakDb: (() => {
        if (!meter) return null;
        const data = new Float32Array(meter.fftSize);
        meter.getFloatTimeDomainData(data);
        const peak = data.reduce((m, v) => Math.max(m, Math.abs(v)), 0);
        return peak ? Math.round(20 * Math.log10(peak)) : -Infinity;
      })(),
    });

    // Toggle
    const toggle = document.querySelector("[data-sfx-toggle]");
    const paint = () => {
      if (!toggle) return;
      toggle.setAttribute("aria-pressed", String(!muted));
      toggle.setAttribute("title", muted ? "Sound off" : "Sound on");
    };
    paint();
    toggle?.addEventListener("click", () => {
      muted = !muted;
      try {
        localStorage.setItem(KEY, muted ? "off" : "on");
      } catch (e) {}
      paint();
      if (!muted) window.__sfx.click();
      window.dispatchEvent(new CustomEvent("fx:music", { detail: window.__music.on }));
    });

    const slider = document.querySelector("[data-sfx-volume]");
    if (slider) {
      slider.value = String(volume);
      slider.addEventListener("input", () => {
        volume = Number(slider.value);
        try {
          localStorage.setItem("bc-vol", String(volume));
        } catch (e) {}
        if (master) master.gain.setTargetAtTime(LEVELS[volume], ctx.currentTime, 0.02);
        // Preview each notch at its new level.
        window.__sfx.select();
      });
    }

    // Interactive things get a hover tick and a click blip.
    const SEL = "a, button, summary, main article, [data-sfx]";
    document.addEventListener(
      "pointerover",
      (event) => {
        const target = event.target instanceof Element ? event.target.closest(SEL) : null;
        if (!target || target.contains(event.relatedTarget)) return;
        const box = target.getBoundingClientRect();
        window.__sfx.hover(Math.min(box.width, box.height));
      },
      { passive: true },
    );
    document.addEventListener(
      "click",
      (event) => {
        const target = event.target instanceof Element ? event.target.closest(SEL) : null;
        if (target && target !== toggle) window.__sfx.click();
      },
      { passive: true },
    );

    // Game-menu brackets: spring to whatever interactive thing is under the
    // pointer. Fixed-position, so it follows scrolling by re-measuring.
    const reticle = document.querySelector("[data-fx-reticle]");
    const TARGETS = "a, button, summary, main article, [data-sfx]";
    let aimed = null;
    let raf = 0;
    const aim = () => {
      if (!reticle || !aimed || !aimed.isConnected) return;
      const r = aimed.getBoundingClientRect();
      // Corners grow with the target: small links get tight brackets, cards
      // get big ones.
      const corner = Math.max(10, Math.min(30, Math.min(r.width, r.height) * 0.22));
      reticle.style.setProperty("--cs", `${corner}px`);
      reticle.style.setProperty("--bw", `${corner > 20 ? 4 : 3}px`);
      reticle.style.setProperty("--d", `${Math.round(corner * 0.25)}px`);
      const pad = Math.round(corner * 0.45);
      reticle.style.width = `${r.width + pad * 2}px`;
      reticle.style.height = `${r.height + pad * 2}px`;
      reticle.style.transform = `translate(${r.left - pad}px, ${r.top - pad}px)`;
    };
    if (reticle && window.matchMedia("(pointer: fine)").matches) {
      document.addEventListener(
        "pointerover",
        (event) => {
          const el = event.target instanceof Element ? event.target.closest(TARGETS) : null;
          // The hero tally and the globe have their own selection.
          const skip = !el || el.closest("[data-tally-marks], [data-globe]");
          if (skip) {
            if (!el) {
              aimed = null;
              reticle.classList.remove("is-on");
            }
            return;
          }
          if (el === aimed) return;
          const first = !reticle.classList.contains("is-on");
          aimed = el;
          if (first) reticle.classList.add("no-move");
          aim();
          if (first) {
            void reticle.offsetWidth;
            reticle.classList.remove("no-move");
          }
          reticle.classList.add("is-on");
          // Re-measure once hover lifts have settled.
          setTimeout(aim, 240);
        },
        { passive: true },
      );
      document.addEventListener("pointerleave", () => {
        aimed = null;
        reticle.classList.remove("is-on");
      });
      window.addEventListener(
        "scroll",
        () => {
          cancelAnimationFrame(raf);
          raf = requestAnimationFrame(aim);
        },
        { passive: true },
      );
    }

    // Section titles: slam in from alternating sides the first time they are
    // seen (like the hero headline), then kick on every downbeat while on screen.
    if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches && "IntersectionObserver" in window) {
      const titles = [...document.querySelectorAll("main .sec-title")];
      const visible = new Set();
      const titleIO = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            const el = entry.target;
            if (entry.isIntersecting) {
              visible.add(el);
              if (!el.dataset.slammed) {
                el.dataset.slammed = "";
                el.classList.add(titles.indexOf(el) % 2 ? "fx-slam-r" : "fx-slam-l");
                setTimeout(() => window.__sfx.clash(), 470);
              }
            } else visible.delete(el);
          });
        },
        { threshold: 0.4 },
      );
      titles.forEach((el) => titleIO.observe(el));
      window.addEventListener("fx:beat", (event) => {
        if (!event.detail.down) return;
        visible.forEach((el) => {
          el.classList.remove("fx-kick");
          void el.offsetWidth;
          el.classList.add("fx-kick");
        });
      });
    }

    // Sections and cards spring in the first time they reach the screen.
    if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches && "IntersectionObserver" in window) {
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            entry.target.classList.add("fx-in");
            io.unobserve(entry.target);
          });
        },
        { threshold: 0.15 },
      );
      const watch = () =>
        document
          .querySelectorAll("main article, main .track, main .figure")
          .forEach((el) => {
            if (el.dataset.fx) return;
            el.dataset.fx = "";
            const box = el.getBoundingClientRect();
            if (box.top < window.innerHeight) return; // already on screen: leave as is
            el.classList.add("fx-wait");
            io.observe(el);
          });
      watch();
      // Cards rendered later from the API.
      new MutationObserver(watch).observe(document.querySelector("main") || document.body, {
        childList: true,
        subtree: true,
      });
    }
  })();
</script>

<style is:global>
  /* Page-wide hover brackets, same look as the hero tally's selector. */
  .fx-reticle {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 40;
    width: 0;
    height: 0;
    pointer-events: none;
    opacity: 0;
    transition:
      transform 260ms cubic-bezier(0.34, 1.56, 0.64, 1),
      width 260ms cubic-bezier(0.34, 1.56, 0.64, 1),
      height 260ms cubic-bezier(0.34, 1.56, 0.64, 1),
      opacity 160ms ease;
  }
  .fx-reticle.is-on { opacity: 1; }
  .fx-reticle.no-move { transition: opacity 160ms ease; }
  .fx-c {
    position: absolute;
    width: var(--cs, 14px);
    height: var(--cs, 14px);
    border: var(--bw, 3px) solid var(--accent);
    transition: width 220ms ease, height 220ms ease;
    animation: fx-breathe 1280ms ease-in-out infinite;
  }
  .fx-tl { top: 0; left: 0; border-right: 0; border-bottom: 0; --dx: calc(var(--d, 3px) * -1); --dy: calc(var(--d, 3px) * -1); }
  .fx-tr { top: 0; right: 0; border-left: 0; border-bottom: 0; --dx: var(--d, 3px); --dy: calc(var(--d, 3px) * -1); }
  .fx-bl { bottom: 0; left: 0; border-right: 0; border-top: 0; --dx: calc(var(--d, 3px) * -1); --dy: var(--d, 3px); }
  .fx-br { bottom: 0; right: 0; border-left: 0; border-top: 0; --dx: var(--d, 3px); --dy: var(--d, 3px); }

  /* Section titles slam in like the hero headline, and kick on the downbeat. */
  .sec-title { will-change: transform; }
  .sec-title.fx-slam-l { animation: fx-slam-l 760ms cubic-bezier(0.55, 0, 1, 0.45) both; }
  .sec-title.fx-slam-r { animation: fx-slam-r 760ms cubic-bezier(0.55, 0, 1, 0.45) both; }
  .sec-title.fx-kick { animation: fx-kick 240ms cubic-bezier(0.34, 1.56, 0.64, 1); }
  @keyframes fx-slam-l {
    0% { transform: translateX(-110vw); }
    62% { transform: translateX(0); }
    72% { transform: translateX(14px) scaleX(0.95); }
    84% { transform: translateX(-5px); }
    100% { transform: none; }
  }
  @keyframes fx-slam-r {
    0% { transform: translateX(110vw); }
    62% { transform: translateX(0); }
    72% { transform: translateX(-14px) scaleX(0.95); }
    84% { transform: translateX(5px); }
    100% { transform: none; }
  }
  @keyframes fx-kick {
    0% { transform: none; }
    35% { transform: translateY(-4px) scale(1.012); }
    100% { transform: none; }
  }
  main .sec { overflow-x: clip; }
  @keyframes fx-breathe {
    0%, 100% { transform: none; }
    50% { transform: translate(var(--dx), var(--dy)); }
  }

  /* Springy buttons: lift on hover, squash on press. */
  .btn,
  .sign-in,
  .trophy-toggle,
  [data-event-open] {
    transition:
      transform 220ms cubic-bezier(0.34, 1.56, 0.64, 1),
      background var(--dur-fast) ease,
      color var(--dur-fast) ease,
      border-color var(--dur-fast) ease;
  }
  .btn:hover,
  .sign-in:hover { transform: translateY(-3px); }
  .btn:active,
  .sign-in:active,
  .trophy-toggle:active,
  [data-event-open]:active { transform: translateY(1px) scale(0.96); transition-duration: 60ms; }

  /* Cards: a little game-menu lift. */
  main article {
    transition: transform 240ms cubic-bezier(0.34, 1.56, 0.64, 1), background var(--dur-normal) ease;
  }
  main article:hover { transform: translateY(-4px); }

  /* First-sight entrance: drop in with an overshoot. */
  .fx-wait { opacity: 0; transform: translateY(24px) scale(0.97); }
  .fx-wait.fx-in {
    opacity: 1;
    transform: none;
    transition:
      opacity 280ms ease-out,
      transform 520ms cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  main article.fx-wait.fx-in:hover { transform: translateY(-4px); }

  @media (prefers-reduced-motion: reduce) {
    .fx-reticle { transition: opacity 160ms ease; }
    .fx-c { animation: none; }
    .sec-title.fx-slam-l, .sec-title.fx-slam-r, .sec-title.fx-kick { animation: none; }
    .btn, .sign-in, .trophy-toggle, [data-event-open], main article { transition: none; }
    .btn:hover, .sign-in:hover, main article:hover { transform: none; }
  }
</style>
