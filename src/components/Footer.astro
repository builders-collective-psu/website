---
interface SiteData {
  name: string;
  location: string;
  domain: string;
  email: string;
  social: {
    linkedin?: string;
    github?: string;
  };
}

interface Props {
  site: SiteData;
}

const { site } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="foot" aria-label="Site footer">
  <div class="wrap inner font-mono">
    <span class="upper">
      {site.name} © {year} · {site.location}
    </span>
    <span class="links">
      <a href={`https://${site.domain}`}>{site.domain}</a>
      <span aria-hidden="true">·</span>
      {site.social.linkedin && (
        <a href={site.social.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>
      )}
      <span aria-hidden="true">·</span>
      <a href={`mailto:${site.email}`}>{site.email}</a>
    </span>
  </div>
</footer>

<style>
  .foot {
    border-top: 1.5px solid var(--ink);
    background: var(--paper);
  }
  .inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 28px 0;
    font-size: 12px;
    color: var(--muted);
    gap: 16px;
    flex-wrap: wrap;
  }
  .links {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
  }
  .links a {
    transition: color var(--dur-fast) ease;
  }
  .links a:hover,
  .links a:focus-visible {
    color: var(--accent);
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }
  @media (max-width: 640px) {
    .inner { font-size: 11px; }
  }
</style>
