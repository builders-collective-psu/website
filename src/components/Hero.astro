---
import Button from "./ui/Button.astro";
import StatBlock from "./ui/StatBlock.astro";
import { REAL_DATA } from "@lib/flags";

interface StatsData {
  wins: number;
  hackathons: number;
  shipped: number;
}

interface Props {
  stats: StatsData;
  location?: string;
}

const { stats, location = "UNIVERSITY PARK, PA" } = Astro.props;

const pad = (n: number) => n.toString().padStart(2, "0");
---

<section class="hero" aria-labelledby="hero-heading">
  <div class="wrap">
    <p class="hero-eyebrow font-mono upper">PENN STATE UNIVERSITY · {location}</p>

    <h1 id="hero-heading" class="display hero-title upper">
      WE SHIP<br />
      <span class="amp">while</span> YOU<br />
      SLEEP.
    </h1>

    <div class="hero-sub">
      <p class="manifesto">
        An elite team of Penn State engineers and designers who build for
        hackathons.
      </p>
      <StatBlock label="WINS" value={pad(stats.wins)} field={REAL_DATA ? "wins" : undefined} />
      <StatBlock
        label="HACKATHONS"
        value={pad(stats.hackathons)}
        field={REAL_DATA ? "hackathons" : undefined}
      />
      <StatBlock label="SHIPPED" value={pad(stats.shipped)} field={REAL_DATA ? "shipped" : undefined} />
    </div>

    <div class="ctas">
      <Button href="#apply" arrow="external">Apply to Build</Button>
      <Button href="#sponsor" variant="ghost" arrow="inline">Sponsor Us</Button>
    </div>
  </div>
</section>

<style>
  .hero {
    padding: 56px 0 48px;
    border-bottom: 2px solid var(--ink);
    position: relative;
  }

  .hero-eyebrow {
    font-size: 12px;
    letter-spacing: 0.16em;
    margin: 0 0 28px;
    color: var(--muted);
  }

  .hero-title {
    font-size: clamp(80px, 14vw, 220px);
    font-weight: 700;
    margin: 0;
    line-height: 0.88;
  }
  .hero-title .amp {
    color: var(--accent);
    font-style: italic;
    font-family: var(--font-serif);
    font-weight: 400;
    letter-spacing: 0;
  }

  .hero-sub {
    margin-top: 28px;
    display: grid;
    grid-template-columns: 1.2fr 1fr 1fr 1fr;
    gap: 24px;
    border-top: 1.5px solid var(--ink);
    padding-top: 18px;
  }

  .manifesto {
    font-size: 22px;
    line-height: 1.18;
    max-width: 36ch;
    letter-spacing: -0.01em;
    margin: 0;
  }

  .ctas {
    display: flex;
    gap: 12px;
    margin-top: 28px;
    flex-wrap: wrap;
  }

  @media (max-width: 900px) {
    .hero-sub { grid-template-columns: 1fr 1fr; }
    .manifesto { grid-column: 1 / -1; }
  }
  @media (max-width: 560px) {
    .hero { padding: 36px 0 32px; }
    .hero-eyebrow { font-size: 11px; }
    .hero-sub { grid-template-columns: 1fr 1fr; gap: 18px; }
    .manifesto { font-size: 18px; }
  }
</style>
