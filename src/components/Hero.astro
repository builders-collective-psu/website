---
import Button from "./ui/Button.astro";
import { REAL_DATA } from "@lib/flags";
import trophies from "@data/trophies.json";
import Globe from "./Globe.astro";

interface StatsData {
  wins: number;
  hackathons: number;
  shipped: number;
  members: number;
}

interface Props {
  stats: StatsData;
  endpoint?: string;
}

const { stats, endpoint = "/api/recaps" } = Astro.props;

const pad = (n: number) => n.toString().padStart(2, "0");

const figures = [
  { key: "wins", label: "Wins", value: stats.wins },
  { key: "hackathons", label: "Hackathons", value: stats.hackathons },
  { key: "shipped", label: "Shipped", value: stats.shipped },
  { key: "members", label: "Members", value: stats.members },
];

// Without live data the tally draws from the checked-in mock trophies.
const mockEvents = trophies.map((t) => ({ event: t.event, start: t.date, end: t.date, count: 1 }));
---

<section class="hero" aria-labelledby="hero-heading" data-hero>
  <div class="wrap top">
    <Globe />
    <h1 id="hero-heading" class="headline display">
      <span class="slam slam--left">We ship <em>while</em></span>
      <span class="slam slam--right">you sleep.</span>
    </h1>

    <figure class="tally" data-tally aria-label="Wins, one stroke per person per win, grouped by event">
      <div class="stagebox">
        <div class="marks" data-tally-marks aria-hidden="true"></div>
        <div class="reticle" data-reticle aria-hidden="true">
          <span class="corner tl"></span><span class="corner tr"></span>
          <span class="corner bl"></span><span class="corner br"></span>
        </div>
      </div>
      <p class="now" data-tally-now aria-live="off">
        <span class="now-name" data-now-name></span>
        <span class="now-meta font-mono upper" data-now-meta></span>
      </p>
    </figure>

    <div class="base">
      <div class="pitch">
        <p>Penn State engineers and designers who build for hackathons.</p>
        <div class="ctas">
          <Button href="#apply" arrow="external">Apply to Build</Button>
          <Button href="#sponsor" variant="ghost" arrow="inline">Sponsor Us</Button>
        </div>
      </div>

      <div class="stats">
      <dl class="figures">
        {
          figures.map((f) => (
            <div class="figure">
              <dt class="font-mono upper">{f.label}</dt>
              <dd data-stat={REAL_DATA ? f.key : undefined} data-stat-format="pad">
                {pad(f.value)}
              </dd>
            </div>
          ))
        }
      </dl>
      <button type="button" class="boombox font-mono upper" data-boombox aria-pressed="true" title="Jazz soundtrack">
        <svg viewBox="0 0 32 20" aria-hidden="true" focusable="false">
          <rect x="1" y="5" width="30" height="14" rx="1.5" fill="none" stroke="currentColor" stroke-width="1.6" />
          <path d="M8 5V2.5h16V5" fill="none" stroke="currentColor" stroke-width="1.6" />
          <circle class="spk" cx="8.5" cy="12" r="3.6" fill="none" stroke="currentColor" stroke-width="1.6" />
          <circle class="spk" cx="23.5" cy="12" r="3.6" fill="none" stroke="currentColor" stroke-width="1.6" />
          <rect x="14" y="9" width="4" height="2" fill="currentColor" />
        </svg>
        <span data-boombox-label>Jazz on</span>
      </button>
      </div>
    </div>
  </div>
</section>

<script is:inline define:vars={{ endpoint, live: REAL_DATA, mockEvents }}>
  (function () {
    const figure = document.querySelector("[data-tally]");
    const marks = document.querySelector("[data-tally-marks]");
    const reticle = document.querySelector("[data-reticle]");
    const nowName = document.querySelector("[data-now-name]");
    const nowMeta = document.querySelector("[data-now-meta]");
    const nowBox = document.querySelector("[data-tally-now]");
    const main = document.getElementById("main");
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (!figure || !marks) return;

    if (!reduced) {
      [471, 891].forEach((t) => setTimeout(() => window.__sfx && window.__sfx.clash && window.__sfx.clash(), t));
    }

    const SVG = "http://www.w3.org/2000/svg";
    const H = 64; // stroke height
    const STEP = 11; // gap between strokes

    // Deterministic wobble so the strokes look hand-drawn but never shift
    // between visits.
    let seed = 7;
    const rand = () => {
      seed = (seed * 16807) % 2147483647;
      return seed / 2147483647;
    };
    const wob = (n) => (rand() - 0.5) * 2 * n;

    const decoder = document.createElement("textarea");
    const plain = (text) => {
      decoder.innerHTML = text == null ? "" : String(text);
      return decoder.value;
    };

    const fmtDates = (start, end) => {
      if (!start) return "";
      const parts = (iso) => {
        const [y, m, d] = String(iso).slice(0, 10).split("-").map(Number);
        return { y, d, mon: new Date(Date.UTC(y, m - 1, d)).toLocaleDateString("en-US", { month: "short", timeZone: "UTC" }) };
      };
      const a = parts(start);
      const b = parts(end || start);
      if (a.y !== b.y) return `${a.mon} ${a.d}, ${a.y} – ${b.mon} ${b.d}, ${b.y}`;
      if (a.mon !== b.mon) return `${a.mon} ${a.d} – ${b.mon} ${b.d}, ${a.y}`;
      if (a.d !== b.d) return `${a.mon} ${a.d}–${b.d}, ${a.y}`;
      return `${a.mon} ${a.d}, ${a.y}`;
    };

    const line = (svg, x1, y1, x2, y2, index) => {
      const l = document.createElementNS(SVG, "line");
      l.setAttribute("x1", x1.toFixed(1));
      l.setAttribute("y1", y1.toFixed(1));
      l.setAttribute("x2", x2.toFixed(1));
      l.setAttribute("y2", y2.toFixed(1));
      l.style.setProperty("--i", String(index));
      svg.appendChild(l);
    };

    // One cluster per event: gates of five (four upright, one across), then
    // the remainder as uprights.
    let strokeIndex = 0;
    function cluster(event) {
      const gates = Math.floor(event.count / 5);
      const rest = event.count % 5;
      const width = gates * (4 * STEP + 10) + rest * STEP + 6;
      const svg = document.createElementNS(SVG, "svg");
      svg.setAttribute("viewBox", `0 0 ${width} ${H + 8}`);
      svg.setAttribute("width", String(width));
      svg.setAttribute("height", String(H + 8));
      svg.setAttribute("class", "cluster");

      let x = 5;
      for (let g = 0; g < gates; g++) {
        const x0 = x;
        for (let k = 0; k < 4; k++) {
          line(svg, x + wob(1.2), 6 + wob(3), x + wob(1.6), H + wob(3), strokeIndex++);
          x += STEP;
        }
        line(svg, x0 - 6 + wob(2), H - 10 + wob(4), x - STEP + 6 + wob(2), 14 + wob(4), strokeIndex++);
        x += 10;
      }
      for (let k = 0; k < rest; k++) {
        line(svg, x + wob(1.2), 6 + wob(3), x + wob(1.6), H + wob(3), strokeIndex++);
        x += STEP;
      }

      const wrap = document.createElement("span");
      wrap.className = "group";
      wrap.setAttribute("data-sfx", "");
      wrap.appendChild(svg);
      wrap._event = event;
      wrap.addEventListener("pointerenter", () => {
        held = true;
        select(groups.indexOf(wrap));
      });
      wrap.addEventListener("pointerleave", () => {
        held = false;
      });
      return wrap;
    }

    // ---------- Selection: a game-menu reticle that hops between groups ----------
    let groups = [];
    let current = -1;
    let held = false;
    let holdUntil = 0;

    // A tap on the globe picks an event by name; hold it for a few beats.
    window.addEventListener("tally:pick", (e) => {
      const name = e.detail;
      const index = groups.findIndex((g) => g._event.event === name);
      if (index < 0) return;
      holdUntil = performance.now() + 4 * (window.__beatPeriod || 640);
      select(index);
      window.__sfx && window.__sfx.select();
    });

    function place(wrap) {
      if (!reticle || !wrap) return;
      const box = marks.getBoundingClientRect();
      const r = wrap.getBoundingClientRect();
      const padX = 10;
      const padY = 8;
      reticle.style.width = `${r.width + padX * 2}px`;
      reticle.style.height = `${r.height + padY * 2}px`;
      reticle.style.transform = `translate(${r.left - box.left - padX}px, ${r.top - box.top - padY}px)`;
    }

    function select(index) {
      if (!groups.length || index < 0) return;
      current = index % groups.length;
      const wrap = groups[current];
      const event = wrap._event;
      groups.forEach((g) => g.classList.toggle("is-on", g === wrap));
      marks.classList.add("is-focused");
      place(wrap);
      reticle && reticle.classList.add("is-live");
      if (nowName) nowName.textContent = event.event;
      window.__tallySelected = event;
      window.dispatchEvent(new CustomEvent("tally:select", { detail: event }));
      if (nowMeta) {
        nowMeta.textContent = [
          `${event.count} ${event.count === 1 ? "win" : "wins"}${event.people ? ` / ${event.people} went` : ""}`,
          event.start ? fmtDates(event.start, event.end) : "",
        ]
          .filter(Boolean)
          .join("  ·  ");
      }
      // Re-trigger the pop on the label each hop.
      if (nowBox) {
        nowBox.classList.remove("is-pop");
        void nowBox.offsetWidth;
        nowBox.classList.add("is-pop");
      }
    }

    window.addEventListener("resize", () => groups[current] && place(groups[current]));

    // ---------- The beat: hop each beat, shake the page on the bar ----------
    // Driven by the page-wide beat clock in GameFX ("fx:beat").
    let inView = false;
    let started = false;

    window.addEventListener("fx:beat", (event) => {
      if (!started || !inView || reduced || !groups.length) return;
      const { down } = event.detail;
      if (!held && performance.now() > holdUntil) select(current + 1);
      figure.classList.remove("is-kick");
      void figure.offsetWidth;
      figure.classList.add("is-kick");
      // With the soundtrack off, mark the beat with a tick instead.
      if (!(window.__music && window.__music.on)) window.__sfx && window.__sfx.beat(down);
      if (down && main) {
        main.classList.remove("is-jolt");
        void main.offsetWidth;
        main.classList.add("is-jolt");
      }
    });

    new IntersectionObserver((entries) => {
      inView = entries.some((e) => e.isIntersecting);
    }, { threshold: 0.35 }).observe(figure);

    // Boombox: the jazz soundtrack, on by default whenever sound is on.
    const boombox = document.querySelector("[data-boombox]");
    const boomLabel = document.querySelector("[data-boombox-label]");
    const paintBoombox = () => {
      if (!boombox || !window.__music) return;
      const on = window.__music.on;
      boombox.setAttribute("aria-pressed", String(on));
      if (boomLabel) boomLabel.textContent = on ? "Jazz on" : "Jazz off";
    };
    boombox && boombox.addEventListener("click", () => {
      window.__music && window.__music.toggle();
      paintBoombox();
    });
    window.addEventListener("fx:music", paintBoombox);
    paintBoombox();

    function draw(events) {
      seed = 7;
      strokeIndex = 0;
      // Oldest first: the tally reads like it was kept, left to right.
      const ordered = events.slice().sort((a, b) => String(a.start || "").localeCompare(String(b.start || "")));
      groups = [];
      groups = ordered.map(cluster);
      marks.replaceChildren(...groups);
      marks.style.setProperty("--total", String(strokeIndex));
      figure.setAttribute("data-drawn", "");
      // Start on the newest group once the strokes have landed.
      setTimeout(() => {
        select(groups.length - 1);
        started = true;
      }, reduced ? 0 : Math.min(1800, strokeIndex * 14 + 300));
    }

    if (!live) {
      draw(mockEvents);
      return;
    }

    window.__recaps =
      window.__recaps ||
      fetch(endpoint, { headers: { accept: "application/json" } }).then((response) => {
        if (!response.ok) throw new Error(`recaps HTTP ${response.status}`);
        return response.json();
      });

    window.__recaps
      .then((data) => {
        // Outings: every event we went to, with who went and how many won.
        if (Array.isArray(data.outings)) {
          const outings = data.outings;
          const won = outings
            .filter((o) => o.wins > 0)
            .map((o) => ({
              event: o.event,
              start: o.start,
              end: o.end,
              count: o.wins,
              people: o.people,
              lat: o.lat,
              lon: o.lon,
            }));
          // Every outing goes on the globe; won ones are marked.
          window.__tallyOutings = outings;
          window.dispatchEvent(new CustomEvent("tally:outings", { detail: outings }));
          if (!won.length) throw new Error("no wins");
          draw(won);
          return;
        }

        // Older API without outings: rebuild the clusters from the wins list.
        const groups = new Map();
        (Array.isArray(data.wins) ? data.wins : []).forEach((win) => {
          const name = plain(win.event);
          const key = name.toLowerCase().replace(/\s+/g, " ").trim();
          if (!groups.has(key)) groups.set(key, { event: name, start: null, end: null, count: 0 });
          const group = groups.get(key);
          group.count += Math.max(1, (win.people || []).length);
          if (!group.start && win.eventStart) {
            group.start = win.eventStart;
            group.end = win.eventEnd || null;
          }
        });
        if (!groups.size) throw new Error("no wins");
        draw([...groups.values()]);
      })
      .catch(() => {
        figure.hidden = true;
      });
  })();
</script>

<style>
  .hero {
    overflow-x: clip;
    border-bottom: var(--rule-major) solid var(--ink);
    padding-block: 44px 40px;
  }

  .top { position: relative; }

  /* ---------- Headline: each line slams in from opposite sides ---------- */
  .slam { display: block; width: max-content; max-width: 100%; }
  .slam--left { animation: slam-left 760ms cubic-bezier(0.55, 0, 1, 0.45) both; }
  .slam--right { animation: slam-right 760ms 420ms cubic-bezier(0.55, 0, 1, 0.45) both; }
  @keyframes slam-left {
    0% { transform: translateX(-110vw); }
    62% { transform: translateX(0); }
    70% { transform: translateX(18px) scaleX(0.94); }
    80% { transform: translateX(-8px) scaleX(1.02); }
    90% { transform: translateX(3px); }
    100% { transform: none; }
  }
  @keyframes slam-right {
    0% { transform: translateX(110vw); }
    62% { transform: translateX(0); }
    70% { transform: translateX(-18px) scaleX(0.94); }
    80% { transform: translateX(8px) scaleX(1.02); }
    90% { transform: translateX(-3px); }
    100% { transform: none; }
  }
  /* The clash: the whole hero takes the hit as each line lands. */
  .hero { animation: clash 220ms 471ms steps(4) 1, clash 220ms 891ms steps(4) 1; }
  @keyframes clash {
    0% { transform: translate(0, 0); }
    25% { transform: translate(-5px, 3px); }
    50% { transform: translate(4px, -3px); }
    75% { transform: translate(-2px, 2px); }
    100% { transform: none; }
  }

  .headline {
    margin: 0;
    font-size: clamp(56px, min(11.5vw, 17svh), 220px);
    line-height: 0.9;
    text-transform: uppercase;
  }
  .headline em {
    font-family: var(--font-serif);
    font-weight: 400;
    font-style: italic;
    text-transform: lowercase;
    letter-spacing: -0.01em;
    color: var(--accent);
  }

  /* ---------- Tally ---------- */
  .tally {
    margin: 36px 0 0;
    padding-top: 20px;
    border-top: var(--rule-major) solid var(--ink);
  }
  .tally[hidden] { display: none; }

  .stagebox { position: relative; }

  .marks {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: 6px 22px;
    min-height: 72px;
  }

  .marks :global(.group) { display: inline-flex; cursor: default; }
  .marks :global(.cluster) { display: block; overflow: visible; }
  .marks :global(.cluster line) {
    stroke: var(--ink);
    stroke-width: 3;
    stroke-linecap: round;
    transition: stroke var(--dur-fast) ease, opacity var(--dur-fast) ease;
  }

  /* While one event is under the pointer, the rest step back. */
  .marks:global(.is-focused) :global(.group:not(.is-on) line) { opacity: 0.22; }
  .marks :global(.group.is-on line) { stroke: var(--accent); }
  .marks :global(.group) { transition: transform 180ms cubic-bezier(0.34, 1.56, 0.64, 1); }
  .tally:global(.is-kick) .marks :global(.group.is-on) { animation: kick 260ms cubic-bezier(0.34, 1.56, 0.64, 1); }
  @keyframes kick {
    0% { transform: translateY(0) scale(1); }
    35% { transform: translateY(-5px) scale(1.08); }
    100% { transform: none; }
  }

  /* Game-menu reticle: four corner brackets that spring to the next pick. */
  .reticle {
    position: absolute;
    top: 0;
    left: 0;
    width: 0;
    height: 0;
    opacity: 0;
    pointer-events: none;
    transition:
      transform 320ms cubic-bezier(0.34, 1.56, 0.64, 1),
      width 320ms cubic-bezier(0.34, 1.56, 0.64, 1),
      height 320ms cubic-bezier(0.34, 1.56, 0.64, 1),
      opacity 200ms ease;
  }
  .reticle:global(.is-live) { opacity: 1; }
  .corner {
    position: absolute;
    width: 12px;
    height: 12px;
    border: 3px solid var(--accent);
    animation: breathe 1280ms ease-in-out infinite;
  }
  .tl { top: 0; left: 0; border-right: 0; border-bottom: 0; --dx: -3px; --dy: -3px; }
  .tr { top: 0; right: 0; border-left: 0; border-bottom: 0; --dx: 3px; --dy: -3px; }
  .bl { bottom: 0; left: 0; border-right: 0; border-top: 0; --dx: -3px; --dy: 3px; }
  .br { bottom: 0; right: 0; border-left: 0; border-top: 0; --dx: 3px; --dy: 3px; }
  @keyframes breathe {
    0%, 100% { transform: none; }
    50% { transform: translate(var(--dx), var(--dy)); }
  }

  /* Name of the selected event, centred under the tallies. */
  .now {
    display: grid;
    justify-items: center;
    gap: 6px;
    margin: 22px 0 0;
    min-height: 64px;
    text-align: center;
  }
  .now-name {
    font-size: clamp(22px, 2.6vw, 34px);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.1;
    color: var(--accent);
  }
  .now-meta { font-size: 11px; letter-spacing: 0.14em; color: var(--muted); }
  .now:global(.is-pop) .now-name { animation: pop 360ms cubic-bezier(0.34, 1.56, 0.64, 1); }
  @keyframes pop {
    0% { transform: translateY(8px) scale(0.86); opacity: 0; }
    100% { transform: none; opacity: 1; }
  }

  /* Page jolt on the downbeat. Applied to <main> so the sticky header and
     the modal stay put. */
  :global(#main.is-jolt) { animation: jolt 140ms steps(3) 1; }
  @keyframes jolt {
    0% { transform: translate(0, 0); }
    33% { transform: translate(-2px, 1px); }
    66% { transform: translate(2px, -1px); }
    100% { transform: none; }
  }

  /* Floaty bits: gentle sine bob, each on its own phase. */
  .headline em { display: inline-block; animation: bob 2.6s ease-in-out infinite; }
  .figure dd { animation: bob 3.2s ease-in-out infinite; }
  .figure:nth-child(2) dd { animation-delay: -0.8s; }
  .figure:nth-child(3) dd { animation-delay: -1.6s; }
  .figure:nth-child(4) dd { animation-delay: -2.4s; }
  @keyframes bob {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-6px); }
  }

  /* Kept like a tally: each stroke lands in order, once. */
  .tally[data-drawn] .marks :global(.cluster line) {
    animation: stroke-in 220ms ease-out backwards;
    animation-delay: calc(var(--i) * 14ms);
  }
  @keyframes stroke-in {
    from { opacity: 0; transform: translateY(-6px); }
    to { opacity: 1; transform: none; }
  }


  /* ---------- Base: pitch + figures ---------- */
  /* Stats column: figures, with the boombox sitting above them on the right. */
  .stats { display: flex; flex-direction: column; align-items: stretch; }
  .stats .figures { order: 2; }
  .boombox {
    order: 1;
    align-self: flex-end;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 14px;
    padding: 6px 10px;
    font-size: 10px;
    letter-spacing: 0.14em;
    color: var(--ink);
    background: none;
    border: 1px solid var(--ink);
    cursor: pointer;
  }
  .boombox svg { width: 28px; height: 18px; }
  .boombox[aria-pressed="true"] .spk { animation: thump 640ms ease-out infinite; transform-box: fill-box; transform-origin: center; }
  .boombox[aria-pressed="false"] { color: var(--muted); border-color: var(--hairline); }
  @keyframes thump {
    0% { transform: scale(1.18); }
    100% { transform: scale(1); }
  }
  .base {
    display: grid;
    grid-template-columns: minmax(240px, 0.8fr) 2fr;
    gap: 40px;
    align-items: end;
    margin-top: 40px;
  }
  .pitch p {
    margin: 0;
    max-width: 30ch;
    font-size: 20px;
    line-height: 1.25;
    letter-spacing: -0.01em;
  }
  .ctas { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 20px; }

  .figures {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    margin: 0;
  }
  .figure { padding-left: 20px; border-left: 1px solid var(--hairline); }
  .figure dt { font-size: 11px; letter-spacing: 0.16em; color: var(--muted); }
  .figure dd {
    margin: 8px 0 0;
    font-size: clamp(40px, 4.2vw, 72px);
    font-weight: 700;
    line-height: 0.9;
    letter-spacing: -0.05em;
    font-variant-numeric: tabular-nums;
  }

  @media (max-width: 1080px) {
    /* Stats column: figures, with the boombox sitting above them on the right. */
  .stats { display: flex; flex-direction: column; align-items: stretch; }
  .stats .figures { order: 2; }
  .boombox {
    order: 1;
    align-self: flex-end;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 14px;
    padding: 6px 10px;
    font-size: 10px;
    letter-spacing: 0.14em;
    color: var(--ink);
    background: none;
    border: 1px solid var(--ink);
    cursor: pointer;
  }
  .boombox svg { width: 28px; height: 18px; }
  .boombox[aria-pressed="true"] .spk { animation: thump 640ms ease-out infinite; transform-box: fill-box; transform-origin: center; }
  .boombox[aria-pressed="false"] { color: var(--muted); border-color: var(--hairline); }
  @keyframes thump {
    0% { transform: scale(1.18); }
    100% { transform: scale(1); }
  }
  .base { grid-template-columns: 1fr; gap: 32px; }
  }
