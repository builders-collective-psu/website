---
import SectionHeader from "./ui/SectionHeader.astro";
import Badge from "./ui/Badge.astro";
import trophies from "@data/trophies.json";

interface LogEvent {
  date: string;
  dateShort: string;
  event: string;
  project: string;
  stack: string[];
  result: { type: string; label: string };
  url?: string;
}

interface LogData {
  season: string;
  events: LogEvent[];
}

interface Props {
  log: LogData;
  limit?: number;
  embedded?: boolean;
}

const { log, limit = 10, embedded = false } = Astro.props;

const events = [...log.events]
  .sort((a, b) => (a.date < b.date ? 1 : -1))
  .slice(0, limit)
  .map(event => ({ ...event, prizeCash: trophies.find(t => t.date === event.date)?.prize.cash }));

const totalEvents = log.events.length;
const totalWins = log.events.filter((e) => e.result.type === "win").length;
const meta = `${totalEvents} EVENTS · ${totalWins} WINS · ${log.season.replace("-", "—")}`;
---

<section class:list={["sec", { embedded }]} id="log" aria-label={embedded ? "All builds and results" : undefined} aria-labelledby={embedded ? undefined : "log-heading"}>
  <div class:list={[!embedded && "wrap"]}>
    {!embedded && <SectionHeader title="Builds & Results" meta={meta} id="log-heading" />}

    <div class="table-wrap">
      <table class="log-table">
        <thead>
          <tr>
            <th class="col-date" scope="col">DATE</th>
            <th scope="col">EVENT</th>
            <th scope="col">PROJECT</th>
            <th scope="col">STACK</th>
            <th scope="col">PRIZES</th>
            <th class="col-result" scope="col">RESULT</th>
          </tr>
        </thead>
        <tbody>
          {
            events.map((e) => (
              <tr class:list={{ "winning-row": e.result.type === "win" }}>
                <td class="t-date font-mono">{e.dateShort}</td>
                <td class="t-event">{e.event}</td>
                <td class="t-project font-mono">
                  {e.url ? (
                    <a href={e.url} target="_blank" rel="noopener noreferrer">{e.project}</a>
                  ) : (
                    e.project
                  )}
                </td>
                <td class="t-stack font-mono">{e.stack.join(" · ")}</td>
                <td class="t-prize font-mono">{e.prizeCash ? `$${e.prizeCash.toLocaleString("en-US")}` : "—"}</td>
                <td>
                  <Badge variant={e.result.type as "win" | "top" | "ship"} label={e.result.label} />
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </div>
</section>

<style>
  .sec {
    padding: 72px 0;
    border-bottom: 1.5px solid var(--ink);
  }

  .table-wrap {
    width: 100%;
    overflow-x: auto;
  }
  .sec.embedded { padding: 0; border: 0; }

  .log-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 15px;
  }

  .log-table th {
    text-align: left;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.16em;
    padding: 10px 12px;
    border-bottom: 1.5px solid var(--ink);
    color: var(--muted);
    font-weight: 500;
    white-space: nowrap;
  }

  .log-table td {
    padding: 18px 12px;
    border-bottom: 1px solid var(--hairline);
    vertical-align: top;
  }

  .log-table tr:last-child td {
    border-bottom: none;
  }

  .log-table tbody tr {
    transition: background var(--dur-normal) ease;
  }
  .log-table tbody tr:hover td { background: var(--paper-2); }
  .winning-row td:first-child { border-left: 3px solid var(--accent); }
  .t-prize { font-size: 13px; white-space: nowrap; color: var(--accent); font-weight: 600; }

  .col-date { width: 120px; }
  .col-result { width: 110px; }

  .t-date {
    font-size: 13px;
    white-space: nowrap;
    color: var(--muted);
  }
  .t-event {
    font-weight: 600;
    font-size: 17px;
    letter-spacing: -0.01em;
  }
  .t-project {
    font-size: 13px;
    color: var(--ink-2);
  }
  .t-project a {
    border-bottom: 1px solid transparent;
    transition: color var(--dur-fast) ease, border-color var(--dur-fast) ease;
  }
  .t-project a:hover,
  .t-project a:focus-visible {
    color: var(--accent);
    border-bottom-color: var(--accent);
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .t-stack {
    font-size: 13px;
    color: var(--ink-2);
  }


  @media (max-width: 640px) {
    .log-table { font-size: 14px; }
    .log-table td { padding: 14px 10px; }
    .t-event { font-size: 15px; }
  }
</style>
