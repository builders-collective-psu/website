---
import "@styles/global.css";
import Gate from "@components/Gate.astro";
import { GATE_ENABLED, gateHashes } from "@lib/gate";
import Masthead from "@components/Masthead.astro";
import Footer from "@components/Footer.astro";
import site from "@data/site.json";
import stats from "@data/stats.json";

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  ogImageAlt?: string;
}

const {
  title = `${site.name} — ${site.tagline}`,
  description = "An elite team of Penn State engineers and designers who build for hackathons.",
  // PNG, not SVG: Discord, Slack and iMessage will not render an SVG preview.
  ogImage = "/og.png",
  ogImageAlt = `${site.name} — ${site.tagline}`,
} = Astro.props;

const gate = GATE_ENABLED ? gateHashes() : null;

const canonical = new URL(Astro.url.pathname, Astro.site ?? "https://psu.builders");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#F4F1EA" />

    {gate && (
      <script is:inline define:vars={{ sha: gate.sha }}>
        (function () {
          var unlocked = false;
          try {
            unlocked = localStorage.getItem("site-gate") === sha;
          } catch (e) {}
          if (!unlocked) {
            // Cookie fallback: survives a different subdomain, and browsers
            // that clear localStorage but keep cookies.
            unlocked = document.cookie.split("; ").indexOf("site-gate=" + sha) !== -1;
          }
          if (!unlocked) document.documentElement.setAttribute("data-locked", "");
        })();
      </script>
    )}

    {/* Set the theme before first paint so there is no flash of the wrong one. */}
    <script is:inline>
      (function () {
        var stored = null;
        try {
          stored = localStorage.getItem("theme");
        } catch (e) {}
        var theme =
          stored === "light" || stored === "dark"
            ? stored
            : window.matchMedia("(prefers-color-scheme: dark)").matches
              ? "dark"
              : "light";
        document.documentElement.dataset.theme = theme;
        document
          .querySelector('meta[name="theme-color"]')
          .setAttribute("content", theme === "dark" ? "#0B1220" : "#F4F1EA");
      })();
    </script>

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.toString()} />

    {/* Open Graph — what Discord, Slack, iMessage and Facebook read. Discord
        needs an absolute image URL, real pixel dimensions to avoid a
        letterboxed thumbnail, and a raster format. */}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.toString()} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={new URL(ogImage, canonical).toString()} />
    <meta property="og:image:secure_url" content={new URL(ogImage, canonical).toString()} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />

    {/* Discord also honours twitter:card — summary_large_image is what makes
        the preview full-width rather than a thumbnail beside the text. */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, canonical).toString()} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.svg" sizes="any" />

    <link rel="dns-prefetch" href="https://fonts.googleapis.com" />
    <link rel="dns-prefetch" href="https://fonts.gstatic.com" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    {/* Non-render-blocking font load — swap to self-hosted woff2 (public/fonts/) when ready */}
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;700&family=Instrument+Serif:ital@0;1&display=swap"
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;700&family=Instrument+Serif:ital@0;1&display=swap"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;700&family=Instrument+Serif:ital@0;1&display=swap"
      />
    </noscript>
  </head>
  <body>
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-50 focus:bg-ink focus:text-paper focus:px-3 focus:py-2 focus:font-mono focus:text-meta">
      Skip to content
    </a>

    {gate && <Gate />}

    <Masthead site={site} stats={stats} />

    <main id="main">
      <slot />
    </main>

    <Footer site={site} />
  </body>
</html>

<style is:global>
  /* While locked, nothing but the gate renders. A curtain over an unfinished
     site — the markup is still in the response, so this is not security. */
  html[data-locked] body > *:not([data-gate]) {
    display: none !important;
  }
  html[data-locked] body {
    overflow: hidden;
  }

  /* The gate markup ships on every response, so it must hide itself whenever
     the visitor is already unlocked. Without this it stays on top — it is
     position: fixed — and every reload looks like a fresh login prompt even
     though the stored token was accepted. */
  html:not([data-locked]) [data-gate] {
    display: none !important;
  }

  /* Visually-hidden helper for screen readers (and skip link) */
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
  .focus\:not-sr-only:focus {
    position: absolute;
    width: auto;
    height: auto;
    padding: 0.5rem 0.75rem;
    margin: 0;
    overflow: visible;
    clip: auto;
    white-space: normal;
  }
</style>
