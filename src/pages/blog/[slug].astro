---
import Base from "@layouts/Base.astro";
import { getPosts, postDate, type Post } from "@lib/blog";

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { Content } = await post.render();
---

<Base title={`${post.data.title} — Builders Collective`} description={post.data.description}>
  <article class="post">
    <div class="wrap">
      <a href="/blog" class="back font-mono upper">← All posts</a>
      <header class="head">
        <time class="font-mono upper" datetime={post.data.date.toISOString().slice(0, 10)}>
          {postDate(post.data.date)}{post.data.author && ` · ${post.data.author}`}
        </time>
        <h1 class="sec-title display upper">{post.data.title}</h1>
        <p class="lede">{post.data.description}</p>
      </header>
      <div class="body">
        <Content />
      </div>
    </div>
  </article>
</Base>

<style>
  .post { padding: 40px 0 96px; }
  .back { font-size: 11px; letter-spacing: 0.14em; color: var(--muted); }
  .back:hover { color: var(--accent); }
  .head { margin: 28px 0 32px; padding-bottom: 24px; border-bottom: 1.5px solid var(--ink); }
  .head time { font-size: 11px; letter-spacing: 0.12em; color: var(--muted); }
  .head h1 { margin: 12px 0 0; font-size: clamp(44px, 7vw, 104px); line-height: 0.92; }
  .lede { margin: 16px 0 0; max-width: 46ch; font-size: 20px; line-height: 1.3; }

  .body { max-width: 68ch; font-size: 18px; line-height: 1.6; }
  .body :global(p) { margin: 0 0 1.1em; }
  .body :global(h2) { margin: 1.8em 0 0.5em; font-size: 28px; letter-spacing: -0.02em; line-height: 1.1; }
  .body :global(h3) { margin: 1.5em 0 0.4em; font-size: 21px; }
  .body :global(ul), .body :global(ol) { margin: 0 0 1.1em; padding-left: 1.2em; }
  .body :global(li) { margin: 0 0 0.4em; }
  .body :global(a) { color: var(--accent); border-bottom: 1px solid currentColor; }
  .body :global(img) { max-width: 100%; height: auto; border: 1.5px solid var(--ink); }
  .body :global(blockquote) { margin: 1.4em 0; padding-left: 18px; border-left: 4px solid var(--accent); color: var(--ink-2); }
  .body :global(code) { font-family: var(--font-mono); font-size: 0.9em; background: var(--paper-2); padding: 1px 5px; }
</style>
