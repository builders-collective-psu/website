# Hack Atlas platform API — read only by the serverless functions in /api,
# never by the browser. Do not prefix with PUBLIC_: that would ship the key
# to every visitor.
#
# The key must belong to an ADMIN account on the platform: everything under
# the OpenAPI prefix is gated on the admin role, and a key inherits its
# owner's role. Generate one from the admin API Keys page (format: atlas_...).
ATLAS_API_BASE="https://atlas.moldycrust.pizza"
ATLAS_API_KEY=""

# Soft gate over the unfinished site. A curtain, not a lock: the HTML is still
# in the response, so never put anything sensitive behind it.
#   SITE_GATE=off  publishes the site openly
# The password is hashed at build time and never shipped in plain text.
SITE_GATE="on"
SITE_GATE_PASSWORD="builders"
