# Hack Atlas platform API — read only by the serverless functions in /api,
# never by the browser. Do not prefix with PUBLIC_: that would ship the key
# to every visitor.
#
# The key must belong to an ADMIN account on the platform: everything under
# the OpenAPI prefix is gated on the admin role, and a key inherits its
# owner's role. Generate one from the admin API Keys page (format: atlas_...).
ATLAS_API_BASE="https://bunker.psu.builders"
ATLAS_API_KEY=""

# Optional soft gate over the site. Leave unset (or empty) and the site is
# open — no gate markup is built at all. Set a password to put the curtain up:
#   SITE_GATE_PASSWORD="somephrase"
# A curtain, not a lock: the HTML is still in the response either way, so
# never put anything sensitive behind it.
SITE_GATE_PASSWORD=""
